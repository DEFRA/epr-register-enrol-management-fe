{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/table/macro.njk" import govukTable %}

{% block content %}
  {% if analytics.confirmation %}
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-two-thirds">
        {{ govukNotificationBanner({
          type: "success",
          text: "You've set your cookie preferences.",
          attributes: { 'data-testid': 'cookies-saved' }
        }) }}
      </div>
    </div>
  {% endif %}

  {{ appHeading({ text: heading }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <p class="govuk-body">Cookies are small files saved on your phone, tablet or computer when you visit a website.</p>
      <p class="govuk-body">We use cookies to make {{ serviceName }} work and, with your permission, to collect information about how you use it.</p>

      <h2 class="govuk-heading-m">Essential cookies</h2>
      <p class="govuk-body">Essential cookies keep your information secure while you use this service. We do not need to ask permission to use them.</p>

      {{ govukTable({
        attributes: { 'data-testid': 'essential-cookies' },
        head: [
          { text: 'Name' },
          { text: 'Purpose' },
          { text: 'Expires' }
        ],
        rows: [
          [
            { text: sessionCookie.name },
            { text: 'Keeps you signed in to the service.' },
            { text: sessionCookie.expires }
          ],
          [
            { text: 'crumb' },
            { text: 'Protects the forms you submit from being forged by other websites.' },
            { text: 'When you close your browser' }
          ],
          [
            { text: 'analyticsConsent' },
            { text: 'Remembers whether you accepted or rejected analytics cookies.' },
            { text: '1 year' }
          ]
        ]
      }) }}

      {% if analytics.isEnabled %}
        <h2 class="govuk-heading-m">Analytics cookies (optional)</h2>
        <p class="govuk-body">With your permission, we use Google Analytics to collect data about how you use this service. This information helps us improve it.</p>

        {{ govukTable({
          attributes: { 'data-testid': 'analytics-cookies' },
          head: [
            { text: 'Name' },
            { text: 'Purpose' },
            { text: 'Expires' }
          ],
          rows: [
            [
              { text: '_ga' },
              { text: 'Checks if you have visited the service before. This helps us count how many people use it.' },
              { text: '400 days' }
            ],
            [
              { text: '_ga_' },
              { text: 'Helps us measure how you use the service.' },
              { text: '400 days' }
            ]
          ]
        }) }}

        <form method="post" action="/cookies/consent" novalidate data-testid="cookies-form">
          <input type="hidden" name="crumb" value="{{ crumb }}">
          <input type="hidden" name="returnUrl" value="/cookies">

          {{ govukRadios({
            name: "analytics",
            fieldset: {
              legend: {
                text: "Do you want to accept analytics cookies?",
                classes: "govuk-fieldset__legend--m"
              }
            },
            items: [
              {
                value: "accepted",
                text: "Use cookies that measure my service use",
                checked: analytics.hasConsented
              },
              {
                value: "rejected",
                text: "Do not use cookies that measure my service use",
                checked: analytics.hasRejected
              }
            ]
          }) }}

          {{ govukButton({
            text: "Save cookie settings",
            attributes: { 'data-testid': 'cookies-save' }
          }) }}
        </form>
      {% endif %}
    </div>
  </div>
{% endblock %}

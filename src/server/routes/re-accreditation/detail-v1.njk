{# ------------------------------------------------------------------- #}
{# Re-accreditation detail template (v1) — RA-98 + RA-132 + RA-295.     #}
{#                                                                      #}
{# Type-specific view selected by the framework's detail controller     #}
{# whenever a work item's `(typeId, templateVersion)` is                 #}
{# `(re-accreditation, v1..v9)`. Extends the generic detail template to #}
{# inherit the case header, tabs, application details, assignment,      #}
{# actions and tasks panels, and overrides the narrow blocks the        #}
{# generic template exposes to add re-accreditation-specific behaviour: #}
{#                                                                      #}
{#  - RA-132 "Approve" CTA in `approveAction`, gated by the controller  #}
{#    via `workItem.canApproveDirectly`.                                #}
{#  - Terminal-state read-only mode: when the work item is approved,    #}
{#    rejected or withdrawn, suppress the decision action panel and     #}
{#    render a status tag.                                             #}
{#  - RA-177 issued-accreditation confirmation panel above the          #}
{#    application details.                                             #}
{#                                                                      #}
{# RA-295 removed the RA-98 reference-implementation notification       #}
{# banner and the "View full application details" link: the application #}
{# data now renders in full on this page, so there is nothing to link   #}
{# out to and no banner to explain.                                     #}
{# ------------------------------------------------------------------- #}

{% extends 'work-items/detail.njk' %}

{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/panel/macro.njk" import govukPanel %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "action-link/macro.njk" import appActionLink %}

{# RA-316. `data-state-id` carries the RAW state id, which is otherwise    #}
{# absent from the DOM — the case header renders only                     #}
{# `stateDisplayName`. That is a problem because RA-324 deliberately gives #}
{# `assessment-in-progress` and `updated` the SAME display name,          #}
{# "Updated", so a journey test asserting on the visible status cannot     #}
{# tell the two apart and would happily pass against the wrong item. The   #}
{# duly-making CTA is offered in one of those states and must never appear #}
{# in the other, which makes the distinction load-bearing rather than      #}
{# cosmetic. Consumed by the mgmt-tests journey suite — treat as contract. #}
{% block content %}
  <div data-testid="re-accreditation-detail"
       data-state-id="{{ workItem.stateId }}">
    {{ super() }}
  </div>
{% endblock %}

{# RA-156. Approve CTA lives in the actionsPanel button group so it      #}
{# renders alongside Reject and Withdraw.                                #}
{% block primaryActions %}{% endblock %}

{# RA-316. Duly-making states own no tasks any more — the backend deleted #}
{# both `submitted` tasks along with the hook that auto-transitioned to   #}
{# `duly-made` when they were ticked. Rendering the generic panel there   #}
{# would show "No tasks are required..." plus a link to an empty tasks    #}
{# page, right beside the Duly make CTA that is the actual thing to do —  #}
{# an active dead end rather than a neutral empty state.                  #}
{#                                                                        #}
{# Gated on `canDulyMake` rather than on `stateId == 'submitted'`, which  #}
{# is what this originally said. The two are NOT equivalent: an item      #}
{# queried during duly making and then resubmitted sits in `updated` and  #}
{# is projected the ORIGINATING state's tasks — i.e. `submitted`'s, which #}
{# are now empty — so a state-literal check would leave the dead-end      #}
{# panel showing on exactly the second entry point into duly making.      #}
{# "The next action here is duly making" is the real condition, and it is #}
{# precisely what `canDulyMake` already answers.                          #}
{#                                                                        #}
{# Every state where duly making is NOT the next action keeps its tasks   #}
{# panel untouched — including `updated` arrived at from assessment or    #}
{# decision. Removing the tasks feature more broadly is RA-410.           #}
{% block tasksPanel %}
  {% if not workItem.canDulyMake %}{{ super() }}{% endif %}
{% endblock %}

{% block approveAction %}
  {% if workItem.canApproveDirectly %}
    <div data-testid="re-accreditation-approve-cta">
      {{ appActionLink({
        text: "Approve",
        href: workItem.approveHref,
        variant: "button",
        classes: "app-case-panel__primary-action",
        disabled: user.isReadOnly,
        testId: "action-approve"
      }) }}
    </div>
  {% endif %}
{% endblock %}

{# RA-132. Once the work item reaches a terminal state, suppress the     #}
{# generic action panel — those would be either no-op or rejected by     #}
{# the backend, which is confusing. Show the status as a govuk tag so    #}
{# the read-only nature is obvious.                                      #}
{# RA-372. "Continue review" — the onward path out of the `updated` state, #}
{# where an operator has answered a query and the case worker has         #}
{# finished looking at the response. It cannot ride on the generic action #}
{# loop below: all four underlying `continue-review-during-*` transitions #}
{# share `fromStateId: 'updated'`, so the backend declares them           #}
{# non-caller-invocable and never projects them into `availableActions`.  #}
{# Which one applies is resolved server-side, hence the POST to the       #}
{# type-specific endpoint with no action id.                              #}
{#                                                                         #}
{# Rendered ABOVE `super()` so it reads as the primary action, and NOT     #}
{# gated on task completion — see `canContinueReview` in the controller.   #}
{# `data-testid` hooks here are an EXTERNAL CONTRACT consumed by the       #}
{# mgmt-tests journey suite; renaming one breaks those specs.             #}
{% block actionsPanel %}
  {% if workItem.isReadOnlyState %}
    <h2 class="govuk-heading-m">Outcome</h2>
    <p class="govuk-body" data-testid="re-accreditation-readonly-actions">
      This work item is in a final state. No further decision actions are available.
    </p>
    <p class="govuk-body govuk-!-margin-bottom-0">
      {{ govukTag({
        text: workItem.stateDisplayName,
        classes: workItem.stateTagClasses,
        attributes: { "data-testid": "re-accreditation-state-tag" }
      }) }}
    </p>
  {% else %}
    {# RA-316. "Duly make" — the first step of the lifecycle, replacing    #}
    {# the task-driven duly making that used to live on the tasks page.    #}
    {# Like Continue review it cannot ride on the generic action loop in   #}
    {# `super()`: the backend declares `duly-make` non-caller-invocable so #}
    {# it never appears in `availableActions`, and it carries a payment    #}
    {# date the generic `/actions/{actionId}` route has nowhere to put.    #}
    {#                                                                     #}
    {# Rendered here rather than inside the generic loop for a second      #}
    {# reason: that loop is wrapped in an `availableActions.length > 0`    #}
    {# check, so a state projecting no generic actions would swallow the   #}
    {# CTA entirely.                                                       #}
    {#                                                                     #}
    {# A LINK, not a posting button — it opens the payment-date page, so   #}
    {# clicking it changes nothing. Gated by `workItem.canDulyMake`, which #}
    {# goes through the same helper that guards the route itself.          #}
    {% if workItem.canDulyMake %}
      <div data-testid="re-accreditation-duly-make-cta">
        {{ appActionLink({
          text: "Duly make",
          href: workItem.dulyMakeHref,
          variant: "button",
          classes: "app-case-panel__primary-action",
          disabled: user.isReadOnly,
          testId: "duly-make-cta"
        }) }}
      </div>
    {% endif %}
    {% if workItem.canContinueReview %}
      <div data-testid="re-accreditation-continue-review-cta">
        <form method="post" action="{{ workItem.continueReviewHref }}" novalidate>
          <input type="hidden" name="crumb" value="{{ crumb }}" />
          {{ govukButton({
            text: "Continue review",
            classes: "app-case-panel__primary-action",
            disabled: user.isReadOnly,
            attributes: { "data-testid": "action-continue-review" }
          }) }}
        </form>
      </div>
    {% endif %}
    {{ super() }}
  {% endif %}
{% endblock %}

{# RA-132 / RA-133 / RA-177. When the work item has been approved,      #}
{# surface the issued accreditation metadata from the backend           #}
{# (`payload.accreditationId`, `payload.accreditationStartDate`,        #}
{# `payload.accreditationYear`) ABOVE the application details as a      #}
{# confirmation panel + a summary list, so the success message is the   #}
{# first thing the user sees after approving.                           #}
{% block summaryListBefore %}
  {% if workItem.decisionMetadata %}
    {{ govukPanel({
      titleText: "Accreditation issued",
      html: 'Accreditation ID<br><strong data-testid="re-accreditation-approval-panel-id">'
            + (workItem.decisionMetadata.accreditationId | escape) + '</strong>',
      attributes: { "data-testid": "re-accreditation-approval-panel" }
    }) }}
    {{ govukSummaryList({
      attributes: { "data-testid": "re-accreditation-decision-metadata" },
      rows: [
        {
          key: { text: "Accreditation ID" },
          value: {
            html: '<span data-testid="re-accreditation-accreditation-id">'
                  + (workItem.decisionMetadata.accreditationId | escape) + '</span>'
          }
        },
        {
          key: { text: "Accreditation start date" },
          value: {
            html: '<span data-testid="re-accreditation-accreditation-start-date">'
                  + (workItem.decisionMetadata.accreditationStartDateFormatted | escape)
                  + '</span>'
          }
        },
        {
          key: { text: "Accreditation year" },
          value: {
            html: '<span data-testid="re-accreditation-accreditation-year">'
                  + ((workItem.decisionMetadata.accreditationYear or '—') | escape)
                  + '</span>'
          }
        }
      ]
    }) }}
  {% endif %}
{% endblock %}

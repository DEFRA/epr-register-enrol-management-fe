{% extends 'layouts/page.njk' %}
{# RA-324. Applications tiles page. Renders inside the default GOV.UK width  #}
{# container (no widening) so it never scrolls horizontally.                 #}

{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/pagination/macro.njk" import govukPagination %}
{% from "govuk/components/tag/macro.njk" import govukTag %}

{% block content %}
  {# ── Row 1: heading + optional "Create work item" button ─────────────── #}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      {{ appHeading({
        text: heading,
        caption: "All work items currently in the case management system"
      }) }}
      {% if showCreateWorkItem %}
        {{ govukButton({
          text: "Create work item",
          href: "/work-items/re-accreditation/new",
          classes: "govuk-button--start govuk-!-font-size-19",
          attributes: { "data-testid": "work-items-create-link" }
        }) }}
      {% endif %}
    </div>
  </div>

  {# ── Row 2: filter sidebar (1/5) + application tiles (4/5) side-by-side ─ #}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-one-quarter app-work-items__filter">
      <form method="get" action="/work-items" novalidate data-testid="work-items-filter-form">
        {# Hidden marker so the controller can tell a real form submission #}
        {# (possibly with everything unchecked) apart from a fresh GET of the #}
        {# page, and decide whether to apply role-based filter defaults (RA-125). #}
        <input type="hidden" name="filtersApplied" value="1">
        <h2 class="govuk-heading-m">Filter</h2>

        {{ govukInput({
          id: "orgId",
          name: "orgId",
          label: { text: "Organisation ID", classes: "govuk-label--s" },
          value: filters.orgId,
          spellcheck: false,
          autocomplete: "off",
          attributes: { "data-testid": "work-items-filter-org-id" }
        }) }}

        {{ govukInput({
          id: "registrationId",
          name: "registrationId",
          label: { text: "Registration ID", classes: "govuk-label--s" },
          value: filters.registrationId,
          spellcheck: false,
          autocomplete: "off",
          attributes: { "data-testid": "work-items-filter-registration-id" }
        }) }}

        {{ govukInput({
          id: "orgName",
          name: "orgName",
          label: { text: "Organisation name", classes: "govuk-label--s" },
          value: filters.orgName,
          spellcheck: false,
          autocomplete: "off",
          attributes: { "data-testid": "work-items-filter-org-name" }
        }) }}

        {% if typeOptions.length > 0 %}
          {{ govukCheckboxes({
            idPrefix: "filter-type",
            name: "typeId",
            classes: "govuk-checkboxes--small",
            fieldset: { legend: { text: "Type", classes: "govuk-fieldset__legend--s" } },
            items: typeOptions
          }) }}
        {% endif %}

        {% if stateOptions.length > 0 %}
          {{ govukCheckboxes({
            idPrefix: "filter-state",
            name: "stateId",
            classes: "govuk-checkboxes--small",
            fieldset: { legend: { text: "State", classes: "govuk-fieldset__legend--s" } },
            items: stateOptions
          }) }}
        {% endif %}

        {% if nationOptions.length > 0 %}
          {{ govukCheckboxes({
            idPrefix: "filter-nation",
            name: "nation",
            classes: "govuk-checkboxes--small",
            fieldset: { legend: { text: "Regulator", classes: "govuk-fieldset__legend--s" } },
            items: nationOptions
          }) }}
        {% endif %}

        {{ govukCheckboxes({
          idPrefix: "filter-applicant-type",
          name: "applicantType",
          classes: "govuk-checkboxes--small",
          fieldset: { legend: { text: "Applicant type", classes: "govuk-fieldset__legend--s" } },
          hint: { text: "Filtering not yet available" },
          items: [
            { value: "reprocessor", text: "Reprocessor", disabled: true },
            { value: "exporter", text: "Exporter", disabled: true }
          ]
        }) }}

        {# Assignee filter (RA-95). The "Specific user…" radio reveals a #}
        {# select listing the assignable-users directory. Same options are #}
        {# offered to every user; only the assign *write* is role-gated. #}
        {% set assigneeUserSelectHtml %}
          {{ govukSelect({
            id: "filter-assignee-user",
            name: "assigneeUserId",
            label: { text: "Assigned to", classes: "govuk-label--s" },
            items: assigneeUserOptions,
            attributes: { "data-testid": "work-items-filter-assignee-user" }
          }) }}
        {% endset %}

        {% set assigneeRadioItems = [] %}
        {% for option in assigneeFilterOptions %}
          {% if option.conditional %}
            {% set _ = assigneeRadioItems.push({
              value: option.value,
              text: option.text,
              checked: option.checked,
              conditional: { html: assigneeUserSelectHtml }
            }) %}
          {% else %}
            {% set _ = assigneeRadioItems.push({
              value: option.value,
              text: option.text,
              checked: option.checked
            }) %}
          {% endif %}
        {% endfor %}

        {{ govukRadios({
          idPrefix: "filter-assignee",
          name: "assigneeMode",
          classes: "govuk-radios--small",
          fieldset: { legend: { text: "Assignment", classes: "govuk-fieldset__legend--s" } },
          items: assigneeRadioItems
        }) }}

        {{ govukCheckboxes({
          idPrefix: "filter-include-archived",
          name: "includeArchived",
          classes: "govuk-checkboxes--small",
          fieldset: { legend: { text: "Archived", classes: "govuk-fieldset__legend--s" } },
          items: [
            {
              value: "true",
              text: "Show archived",
              checked: filters.includeArchived,
              attributes: { "data-testid": "work-items-filter-include-archived" }
            }
          ]
        }) }}

        <div class="govuk-button-group">
          {{ govukButton({ text: "Apply filters", attributes: { "data-testid": "work-items-filter-apply" } }) }}
          {% if hasFilters %}
            <a class="govuk-link" href="/work-items" data-testid="work-items-filter-clear">Clear filters</a>
          {% endif %}
        </div>
      </form>
    </div>

    <div class="govuk-grid-column-three-quarters app-work-items__results">
      {% if not ok %}
        {# `text:` is auto-escaped by the govuk macro and wrapped in the   #}
        {# notification-banner heading paragraph; never concatenate raw    #}
        {# backend strings into `html:` (epr-6fi).                         #}
        {{ govukNotificationBanner({
          titleText: "Could not reach the backend",
          text: error or "Unknown error"
        }) }}
      {% else %}
        <p class="govuk-body" data-testid="work-items-summary">
          {% if totalCount === 0 %}
            {% if hasFilters %}
              No work items match your filters.
            {% else %}
              No work items have been submitted yet.
            {% endif %}
          {% else %}
            Showing page <strong>{{ page }}</strong> of <strong>{{ totalPages }}</strong>
            ({{ totalCount }} work item{% if totalCount != 1 %}s{% endif %}{% if filterSummary.description %} — {{ filterSummary.description }}{% endif %})
          {% endif %}
        </p>

        {% if items.length > 0 %}
          {# RA-324. Applications render as tiles (AC04): one card per      #}
          {# application, fields in the AC05 order, status as a coloured     #}
          {# badge contained in the tile (AC07/08). GOV.UK macros only — no  #}
          {# JavaScript (RA-94). Field data-testids repeat across tiles and  #}
          {# are scoped by the enclosing tile; per-item hooks (link, badge,  #}
          {# archived) are id-keyed for the e2e suite.                        #}
          {# The field list is hand-written (not the govukSummaryList macro)  #}
          {# because the macro drops `attributes` on the value cell, and the  #}
          {# e2e suite needs a data-testid on each field's <dd>. Every        #}
          {# interpolation below is a plain `{{ ... }}` so Nunjucks           #}
          {# auto-escapes it — no raw backend string is concatenated into     #}
          {# markup (epr-6fi). Field order is the AC05 contract.              #}
          <ul class="govuk-list app-application-cards" data-testid="applications-list">
            {% for item in items %}
              {% set assignedTo = item.assigneeDisplayName or "Unassigned" %}
              <li>
                <article class="app-application-card" data-testid="application-tile" data-work-item-id="{{ item.id }}">
                  {# Header: application ref (field 1) as the navigating link  #}
                  {# + the status badge (AC07). RA-249: when a legacy item has #}
                  {# no ref the link keeps an accessible name for SRs.         #}
                  <div class="app-application-card__header">
                    <h2 class="govuk-heading-s app-application-card__title">
                      <a class="govuk-link" href="/work-items/{{ item.id | urlencode }}" data-testid="work-item-link-{{ item.id }}">{{ item.applicationRef }}{% if not item.applicationRef %}<span class="govuk-visually-hidden">View application</span>{% endif %}</a>
                    </h2>
                    {{ govukTag({ text: item.stateDisplayName, classes: item.stateTagClass, attributes: { "data-testid": "work-item-state-tag-" + item.id } }) }}
                  </div>
                  <dl class="govuk-summary-list govuk-summary-list--no-border app-application-card__list">
                    <div class="govuk-summary-list__row">
                      <dt class="govuk-summary-list__key">Organisation name</dt>
                      <dd class="govuk-summary-list__value" data-testid="org-name">{{ item.orgName or "—" }}</dd>
                    </div>
                    <div class="govuk-summary-list__row">
                      <dt class="govuk-summary-list__key">Organisation ID</dt>
                      <dd class="govuk-summary-list__value" data-testid="org-id">{{ item.orgId or "—" }}</dd>
                    </div>
                    <div class="govuk-summary-list__row">
                      <dt class="govuk-summary-list__key">Material type</dt>
                      <dd class="govuk-summary-list__value" data-testid="material">{{ item.material or "—" }}</dd>
                    </div>
                    <div class="govuk-summary-list__row">
                      <dt class="govuk-summary-list__key">Applicant type</dt>
                      <dd class="govuk-summary-list__value" data-testid="applicant-type">{{ item.typeDisplayName }}</dd>
                    </div>
                    {% if item.showSubmittedOn %}
                    <div class="govuk-summary-list__row">
                      <dt class="govuk-summary-list__key">Submitted on</dt>
                      <dd class="govuk-summary-list__value" data-testid="submitted-on">{{ item.submittedAt | formatDateGds or "—" }}</dd>
                    </div>
                    {% endif %}
                    <div class="govuk-summary-list__row">
                      <dt class="govuk-summary-list__key">Assigned to</dt>
                      <dd class="govuk-summary-list__value" data-testid="assigned-to">{{ assignedTo }}</dd>
                    </div>
                    {% if item.showDueDate %}
                    <div class="govuk-summary-list__row">
                      <dt class="govuk-summary-list__key">Due date</dt>
                      <dd class="govuk-summary-list__value" data-testid="due-date">{% if item.slaTagText %}{{ govukTag({ text: item.slaTagText, classes: item.slaTagClass }) }}{% if item.slaRemainingText %} <span class="govuk-body-s">{{ item.slaRemainingText }}</span>{% endif %}{% else %}—{% endif %}</dd>
                    </div>
                    {% endif %}
                    {% if item.archivedAt %}
                    <div class="govuk-summary-list__row">
                      <dt class="govuk-summary-list__key">Archived</dt>
                      <dd class="govuk-summary-list__value" data-testid="work-item-archived-at-{{ item.id }}">{{ item.archivedAt }}</dd>
                    </div>
                    {% endif %}
                  </dl>
                </article>
              </li>
            {% endfor %}
          </ul>

          {% if pagination %}
            {{ govukPagination(pagination) }}
          {% endif %}
        {% endif %}
      {% endif %}
    </div>
  </div>
{% endblock %}

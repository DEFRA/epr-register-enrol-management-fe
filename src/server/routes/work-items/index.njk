{% extends 'layouts/page.njk' %}
{# RA-324. Applications page. Renders inside the default GOV.UK width          #}
{# container (no widening) so it never scrolls horizontally.                   #}

{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/select/macro.njk" import govukSelect %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/pagination/macro.njk" import govukPagination %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "action-link/macro.njk" import appActionLink %}

{# RA-324 phase-2. Collapsible filter section built on the native <details>    #}
{# element — collapses WITHOUT JavaScript (RA-94). The `open` attribute is set #}
{# server-side when the section has an active selection, and the summary shows #}
{# a "N selected" count when collapsed.                                        #}
{% macro filterSection(key, title, count) %}
  <details class="govuk-details app-filter-section" data-testid="filter-section-{{ key }}"{% if count > 0 %} open{% endif %}>
    <summary class="govuk-details__summary" data-testid="filter-section-{{ key }}-toggle">
      <span class="govuk-details__summary-text">{{ title }}{% if count > 0 %} ({{ count }} selected){% endif %}</span>
    </summary>
    <div class="govuk-details__text">
      {{ caller() }}
    </div>
  </details>
{% endmacro %}

{% block content %}
  {# ── Row 1: heading + optional "Create work item" button ─────────────── #}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      {{ appHeading({
        text: heading,
        caption: "All work items currently in the case management system"
      }) }}
      {% if showCreateWorkItem %}
        {{ appActionLink({
          text: "Create work item",
          href: "/work-items/re-accreditation/new",
          variant: "button",
          classes: "govuk-button--start govuk-!-font-size-19",
          disabled: user.isReadOnly,
          testId: "work-items-create-link"
        }) }}
      {% endif %}
    </div>
  </div>

  {# ── Row 2: filter sidebar (1/4) + application cards (3/4) side-by-side ─ #}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-one-quarter app-work-items__filter">
      <form method="get" action="/work-items" novalidate data-testid="work-items-filter-form">
        {# Hidden marker so the controller can tell a real form submission #}
        {# (possibly with everything unchecked) apart from a fresh GET of the #}
        {# page, and decide whether to apply role-based filter defaults (RA-125). #}
        <input type="hidden" name="filtersApplied" value="1">

        {# ── Active filters: each active filter as a removable tag (a link #}
        {# whose href rebuilds the query minus that one filter) + Clear all. #}
        {# Progressive-enhancement friendly: removal is server-side via links. #}
        {% if activeFilters.chips.length > 0 %}
          <div class="app-active-filters" data-testid="active-filters">
            <h2 class="govuk-heading-s govuk-!-margin-bottom-2">Active filters</h2>
            <ul class="govuk-list app-active-filters__list">
              {% for chip in activeFilters.chips %}
                <li>
                  <a class="govuk-link app-active-filters__tag" href="{{ chip.href }}" data-testid="active-filter-remove">
                    <span aria-hidden="true" class="app-active-filters__remove-icon">×</span>
                    <span class="app-active-filters__label" data-testid="active-filter-label">{{ chip.label }}</span>
                    <span class="govuk-visually-hidden">(remove this filter)</span>
                  </a>
                </li>
              {% endfor %}
            </ul>
            <a class="govuk-link" href="{{ activeFilters.clearAllHref }}" data-testid="active-filters-clear">Clear all filters</a>
          </div>
        {% endif %}

        {# 1. Sort by (radios) #}
        {% set sortRadioItems = [] %}
        {% for o in sortOptions %}
          {% set _ = sortRadioItems.push({ value: o.value, text: o.text, checked: o.checked, attributes: { "data-testid": "filter-sort-" + o.value } }) %}
        {% endfor %}
        {% call filterSection('sort', 'Sort by', filterCounts.sort) %}
          {{ govukRadios({
            idPrefix: "filter-sort",
            name: "sort",
            classes: "govuk-radios--small",
            fieldset: { legend: { text: "Sort by", classes: "govuk-visually-hidden" } },
            items: sortRadioItems
          }) }}
        {% endcall %}

        {# 2. Applicant type (checkboxes). RA-299: relabelled from "Type" to  #}
        {# "Applicant type" to disambiguate from the new "Application type"  #}
        {# section below — the param name/values (typeId=) are unchanged.    #}
        {% call filterSection('type', 'Applicant type', filterCounts.type) %}
          {{ govukCheckboxes({
            idPrefix: "filter-type",
            name: "typeId",
            classes: "govuk-checkboxes--small",
            fieldset: { legend: { text: "Applicant type", classes: "govuk-visually-hidden" } },
            items: typeOptions
          }) }}
        {% endcall %}

        {# 2b. Application type (checkboxes). RA-299 AC01/15: a SECOND,      #}
        {# distinct type filter (what kind of application it is), separate  #}
        {# from "Applicant type" above (who is applying). Submitted via its #}
        {# own `applicationType=` param.                                    #}
        {% call filterSection('application-type', 'Application type', filterCounts.applicationType) %}
          {{ govukCheckboxes({
            idPrefix: "filter-application-type",
            name: "applicationType",
            classes: "govuk-checkboxes--small",
            fieldset: { legend: { text: "Application type", classes: "govuk-visually-hidden" } },
            items: applicationTypeOptions
          }) }}
        {% endcall %}

        {# 3. Nation (checkboxes) #}
        {% call filterSection('nation', 'Nation', filterCounts.nation) %}
          {{ govukCheckboxes({
            idPrefix: "filter-nation",
            name: "nation",
            classes: "govuk-checkboxes--small",
            fieldset: { legend: { text: "Nation", classes: "govuk-visually-hidden" } },
            items: nationOptions
          }) }}
        {% endcall %}

        {# 4. Material (checkboxes) #}
        {% call filterSection('material', 'Material', filterCounts.material) %}
          {{ govukCheckboxes({
            idPrefix: "filter-material",
            name: "material",
            classes: "govuk-checkboxes--small",
            fieldset: { legend: { text: "Material", classes: "govuk-visually-hidden" } },
            items: materialOptions
          }) }}
        {% endcall %}

        {# 5. Assignment (radios; "Specific officer" reveals a select). #}
        {% set assigneeUserSelectHtml %}
          {{ govukSelect({
            id: "filter-assignee-user",
            name: "assigneeUserId",
            label: { text: "Officer", classes: "govuk-label--s" },
            items: assigneeUserOptions,
            attributes: { "data-testid": "work-items-filter-assignee-user" }
          }) }}
        {% endset %}
        {% set assigneeRadioItems = [] %}
        {% for option in assigneeFilterOptions %}
          {% if option.conditional %}
            {% set _ = assigneeRadioItems.push({ value: option.value, text: option.text, checked: option.checked, conditional: { html: assigneeUserSelectHtml } }) %}
          {% else %}
            {% set _ = assigneeRadioItems.push({ value: option.value, text: option.text, checked: option.checked }) %}
          {% endif %}
        {% endfor %}
        {% call filterSection('assignment', 'Assignment', filterCounts.assignment) %}
          {{ govukRadios({
            idPrefix: "filter-assignee",
            name: "assigneeMode",
            classes: "govuk-radios--small",
            fieldset: { legend: { text: "Assignment", classes: "govuk-visually-hidden" } },
            items: assigneeRadioItems
          }) }}
        {% endcall %}

        {# 6. Status (checkboxes, AC06 labels) #}
        {% call filterSection('status', 'Status', filterCounts.status) %}
          {{ govukCheckboxes({
            idPrefix: "filter-status",
            name: "status",
            classes: "govuk-checkboxes--small",
            fieldset: { legend: { text: "Status", classes: "govuk-visually-hidden" } },
            items: statusOptions
          }) }}
        {% endcall %}

        {# 7. Organisation (combined name-or-ID text input) #}
        {% call filterSection('organisation', 'Organisation', filterCounts.organisation) %}
          {{ govukInput({
            id: "filter-organisation",
            name: "organisation",
            label: { text: "Organisation name or ID", classes: "govuk-label--s" },
            value: filters.organisation,
            spellcheck: false,
            autocomplete: "off",
            attributes: { "data-testid": "work-items-filter-org-search" }
          }) }}
        {% endcall %}

        {# 8. Archived (toggle; reveals archived work items) #}
        {% call filterSection('archived', 'Archived', filterCounts.archived) %}
          {{ govukCheckboxes({
            idPrefix: "filter-archived",
            name: "includeArchived",
            classes: "govuk-checkboxes--small",
            fieldset: { legend: { text: "Archived", classes: "govuk-visually-hidden" } },
            items: [
              {
                value: "true",
                text: "Show archived items",
                checked: filters.includeArchived,
                attributes: { "data-testid": "work-items-filter-include-archived" }
              }
            ]
          }) }}
        {% endcall %}

        {# The only "clear" affordance is the "Clear all filters" link in the #}
        {# Active filters block above — no duplicate link down here (prototype). #}
        <div class="govuk-button-group govuk-!-margin-top-4">
          {{ govukButton({ text: "Apply filters", attributes: { "data-testid": "work-items-filter-apply" } }) }}
        </div>
      </form>
    </div>

    <div class="govuk-grid-column-three-quarters app-work-items__results">
      {% if not ok %}
        {# `text:` is auto-escaped by the govuk macro and wrapped in the   #}
        {# notification-banner heading paragraph; never concatenate raw    #}
        {# backend strings into `html:` (epr-6fi).                         #}
        {{ govukNotificationBanner({
          titleText: "Could not reach the backend",
          text: error or "Unknown error"
        }) }}
      {% else %}
        {% if totalCount === 0 and not hasFilters %}
          <p class="govuk-body govuk-!-font-weight-bold govuk-!-margin-bottom-1" data-testid="work-items-empty-title">No items to process.</p>
          <p class="govuk-hint" data-testid="work-items-empty-message">There are currently no work items to display. New items will appear here as they are received.</p>
        {% else %}
          <p class="govuk-body" data-testid="work-items-summary">
            {% if totalCount === 0 %}
              No work items match your filters.
            {% else %}
              {# RA-324 phase-2 (prototype). Just the item range + total —    #}
              {# no filter/sort recap here, the Active filters chips above    #}
              {# already communicate what's applied. Bold per the prototype.  #}
              <strong>Showing {{ rangeStart }}-{{ rangeEnd }} of {{ totalCount }}</strong>
            {% endif %}
          </p>
        {% endif %}

        {% if items.length > 0 %}
          {# RA-324 phase-2 / RA-370. Applications render as cards matching     #}
          {# the prototype (AC04): an application-ref link + status badge in   #}
          {# the header, then the card body. GOV.UK macros + plain HTML only,  #}
          {# no JavaScript (RA-94). Every interpolation is a plain `{{ ... }}` #}
          {# so Nunjucks auto-escapes it (epr-6fi). Field data-testids are     #}
          {# scoped by the enclosing card; per-item hooks (link, badge,        #}
          {# archived) are id-keyed for the e2e suite.                         #}
          {#                                                                   #}
          {# RA-370 fixes the field ORDER, which must be identical on every    #}
          {# card. In render order:                                            #}
          {#   1. Application ref no   (header link)                           #}
          {#   2. Org name            \                                        #}
          {#   3. Org ID              / one "{Org} ({Org ID})" line            #}
          {#      Registration number  (RA-295 AC06 — not an RA-370 field;     #}
          {#                            kept here, grouped with the other      #}
          {#                            organisation-identity values)          #}
          {#   4. Material type      \                                         #}
          {#   5. Applicant type     / one title line, material first          #}
          {#   6. Submitted on       \ footer — see the footer comment below   #}
          {#   7. Assigned to        | for the visibility rules                #}
          {#   8. Due date           /                                         #}
          <ul class="govuk-list app-application-cards" data-testid="applications-list">
            {% for item in items %}
              <li>
                <article class="app-application-card" data-testid="application-tile" data-work-item-id="{{ item.id }}">
                  <div class="app-application-card__header">
                    <h2 class="govuk-heading-s app-application-card__ref">
                      <a class="govuk-link" href="/work-items/{{ item.id | urlencode }}" data-testid="work-item-link-{{ item.id }}">{{ item.applicationRef }}{% if not item.applicationRef %}<span class="govuk-visually-hidden">View application</span>{% endif %}</a>
                    </h2>
                    {{ govukTag({ text: item.stateDisplayName, classes: item.stateTagClass, attributes: { "data-testid": "work-item-state-tag-" + item.id } }) }}
                  </div>

                  <p class="govuk-body app-application-card__org" data-testid="application-org">
                    <span data-testid="org-name">{{ item.orgName or "—" }}</span>{% if item.orgId %} (<span data-testid="org-id">{{ item.orgId }}</span>){% endif %}
                  </p>

                  {# RA-295 AC06. Registration number on every card. This is  #}
                  {# `registrationNumber` (EPR-xxxxxx), NOT the similarly     #}
                  {# named `operatorRegistrationId` (reg-xxx) from RA-223.    #}
                  <p class="govuk-body app-application-card__org" data-testid="application-registration">
                    <span class="app-application-card__meta-label">Registration number:</span>
                    <span data-testid="registration-number">{{ item.registrationNumber or "—" }}</span>
                  </p>

                  {# RA-370. Material type then applicant type, in that order.   #}
                  {# RA-434-processortype: applicant type is now the DECORATED   #}
                  {# `item.applicantType` (read from the real                    #}
                  {# `payload.wasteProcessingType` in controller.js's decorate), #}
                  {# not a hard-coded literal — falls back to an em dash for a   #}
                  {# work item that predates the field, matching every other     #}
                  {# "no data" field on this card.                               #}
                  <p class="govuk-body app-application-card__title" data-testid="application-card-title">
                    <span data-testid="material">{{ item.material or "—" }}</span> reaccreditation (<span data-testid="applicant-type">{{ item.applicantType or "—" }}</span>)
                  </p>

                  {# RA-370. The footer always renders, because "Assigned to" is #}
                  {# no longer gated on the SLA clock — it shows "Unassigned"    #}
                  {# when nobody holds the case. The two dates either side of it #}
                  {# are gated on INDEPENDENT signals: "Submitted on" on the     #}
                  {# work item's state (assessment not yet started) and "Due on" #}
                  {# on the SLA clock. Any combination of the two can therefore  #}
                  {# render, including both and neither — do not assume one. In  #}
                  {# the neither case the footer legitimately carries just the   #}
                  {# "Assigned to" value. See PRE_ASSESSMENT_STATE_IDS in        #}
                  {# controller.js for the full reasoning.                       #}
                  <div class="app-application-card__footer" data-testid="application-card-footer">
                    {% if item.showSubmittedOn %}
                      <span class="app-application-card__meta"><span class="app-application-card__meta-label">Submitted on:</span> <span data-testid="submitted-on">{{ item.submittedOn | formatDateGds or "—" }}</span></span>
                    {% endif %}
                    <span class="app-application-card__meta"><span class="app-application-card__meta-label">Assigned to:</span> <span data-testid="assigned-to">{{ item.assigneeDisplayName or "Unassigned" }}</span></span>
                    {% if item.showDueDate %}
                      <span class="app-application-card__meta"><span class="app-application-card__meta-label">Due on:</span> <span data-testid="due-on">{{ item.dueOn | formatDateGds or "—" }}</span></span>
                    {% endif %}
                  </div>

                  {% if item.archivedAt %}
                    <p class="govuk-body-s app-application-card__archived" data-testid="work-item-archived-at-{{ item.id }}">Archived: {{ item.archivedAt }}</p>
                  {% endif %}
                </article>
              </li>
            {% endfor %}
          </ul>

          {% if pagination %}
            {{ govukPagination(pagination) }}
          {% endif %}
        {% endif %}
      {% endif %}
    </div>
  </div>
{% endblock %}

{% extends 'layouts/page.njk' %}

{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "work-items/summary-macros.njk" import businessPlanPair, documentItem, overseasSiteList %}

{# ---------------------------------------------------------------- #}
{# RA-769. The Accreditation summary tab of an In-Year Change case:  #}
{# the accreditation as it stands today, read live. Information      #}
{# only, so no assignment panel and no case actions. When there is   #}
{# nothing to show, or it cannot be read, the heading stays and the  #}
{# message replaces the intro and the rows. The data-testid hooks    #}
{# are a contract with mgmt-tests.                                   #}
{# ---------------------------------------------------------------- #}

{% block content %}
  {{ appCaseTabs({ tabs: caseTabs }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds" data-testid="accreditation-summary-tab">
      <h2 class="govuk-heading-m" data-testid="accreditation-summary-heading">{{ heading }}</h2>

      {% if accreditationSummary %}
        <p class="govuk-body" data-testid="accreditation-summary-intro">{{ intro }}</p>

        <dl class="govuk-summary-list app-summary-list--borderless"
            data-testid="accreditation-summary-details">
          {% for row in accreditationSummary.rows %}
            <div class="govuk-summary-list__row"
                 data-testid="acc-summary-row-{{ row.key }}">
              <dt class="govuk-summary-list__key">{{ row.label }}</dt>
              <dd class="govuk-summary-list__value"
                  data-testid="acc-summary-value-{{ row.key }}">
                {% if row.kind == 'tag' %}
                  {{ govukTag({ text: row.value, classes: row.tagClass }) }}
                {% elif row.kind == 'lines' %}
                  {% for line in row.values %}
                    <p class="govuk-body govuk-!-margin-bottom-1"
                       data-testid="acc-summary-line">{{ line }}</p>
                  {% else %}
                    —
                  {% endfor %}
                {% elif row.kind == 'files' %}
                  {% if row.files.length %}
                    <ul class="govuk-list">
                      {% for file in row.files %}{{ documentItem(file) }}{% endfor %}
                    </ul>
                  {% else %}
                    —
                  {% endif %}
                {% elif row.kind == 'bes-sites' %}
                  {% for site in row.sites %}
                    <div data-testid="bes-site">
                      <p class="govuk-body govuk-!-margin-bottom-1">
                        <strong>{{ site.siteName }}</strong>{% if site.country %} ({{ site.country }}){% endif %}
                      </p>
                      {% if site.files.length %}
                        <ul class="govuk-list">
                          {% for file in site.files %}{{ documentItem(file) }}{% endfor %}
                        </ul>
                      {% endif %}
                    </div>
                  {% else %}
                    —
                  {% endfor %}
                {% elif row.kind == 'pairs' %}
                  {% for pair in row.pairs %}{{ businessPlanPair(pair, 'acc-summary-pair') }}
                  {% else %}
                    —
                  {% endfor %}
                {% elif row.kind == 'overseas-sites' %}
                  {{ overseasSiteList(row.sites, { hideNewMarkers: true, showNoInterimSites: true }) }}
                {% else %}
                  {{ row.value }}
                {% endif %}
              </dd>
            </div>
          {% endfor %}
        </dl>
      {% else %}
        <p class="govuk-body" data-testid="accreditation-summary-unavailable">{{ unavailableMessage }}</p>
      {% endif %}
    </div>
  </div>
{% endblock %}

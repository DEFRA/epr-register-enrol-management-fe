{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/character-count/macro.njk" import govukCharacterCount %}
{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}

{# RA-291: Query an application. No browser JS is required — the        #}
{# character count is progressive enhancement only, all validation is   #}
{# server-side and the form is a plain POST with a PRG redirect.        #}

{% block content %}
  {{ appHeading({
    text: heading,
    caption: ("Work item " + workItem.applicationRef) if workItem.applicationRef else null
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      {% if errorSummary %}
        {{ govukErrorSummary({
          titleText: errorSummary.titleText,
          errorList: errorSummary.items,
          attributes: { "data-testid": "query-error-summary" }
        }) }}
      {% endif %}

      {% if addOrs %}
        {# RA-698. An add-ORS item is one ORS, so the query is the combined   #}
        {# ORS + BES one: show the ORS, one fixed scope, no checkboxes.        #}
        <p class="govuk-body" data-testid="query-lead">
          Ask the operator to update this overseas reprocessing site or its
          BES evidence. You'll get a notification when the operator resubmits.
        </p>

        <dl class="govuk-summary-list" data-testid="query-ors">
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">ORS name</dt>
            <dd class="govuk-summary-list__value" data-testid="query-ors-name">{{ addOrs.name or "—" }}</dd>
          </div>
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">ORS ID</dt>
            <dd class="govuk-summary-list__value" data-testid="query-ors-id">{{ addOrs.orsId or "—" }}</dd>
          </div>
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Location</dt>
            <dd class="govuk-summary-list__value" data-testid="query-ors-location">{{ addOrs.location or "—" }}</dd>
          </div>
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Query scope</dt>
            <dd class="govuk-summary-list__value" data-testid="query-scope">Overseas reprocessing site and BES evidence</dd>
          </div>
        </dl>
      {% else %}
        <p class="govuk-body" data-testid="query-lead">
          Unlock parts of the application that need to be updated. You'll get a
          notification when the operator resubmits.
        </p>
      {% endif %}

      <form method="post"
            action="{{ formAction }}"
            novalidate
            data-testid="query-form">
        <input type="hidden" name="crumb" value="{{ crumb }}" />

        {% if not addOrs %}
        {{ govukCheckboxes({
          idPrefix: "field-sections",
          id: "field-sections",
          name: "sections",
          fieldset: {
            legend: {
              text: "Which areas do you want to query?",
              classes: "govuk-fieldset__legend--m"
            }
          },
          hint: {
            text: "This will unlock the questions for the operator to resubmit."
          },
          items: sectionItems,
          errorMessage: { text: fieldErrors["sections"] } if fieldErrors["sections"] else null,
          attributes: { "data-testid": "query-sections" }
        }) }}
        {% endif %}

        {{ govukCharacterCount({
          id: "field-reason",
          name: "reason",
          maxwords: maxWords,
          label: {
            text: "Reason for the query (optional)",
            classes: "govuk-label--m"
          },
          hint: {
            text: "The note you provide is sent to the operator with the query." if addOrs else "The reason you provide is for internal use only.",
            attributes: { "data-testid": "query-reason-hint" }
          },
          value: values.reason,
          errorMessage: { text: fieldErrors["reason"] } if fieldErrors["reason"] else null,
          attributes: { "data-testid": "query-reason" }
        }) }}

        {# RA-295 AC04. Shown if — and ONLY if — the application is           #}
        {# currently unassigned. Sending a query assigns the application to   #}
        {# the caseworker, so telling an assignee (or a colleague looking at  #}
        {# someone else's assigned case) that it "will also be assigned to    #}
        {# you" is either redundant or wrong.                                 #}
        {% if isUnassigned %}
          {{ govukInsetText({
            text: "The operator query status will be updated.",
            attributes: { "data-testid": "query-assignment-notice" }
          }) }}
        {% endif %}

        <div class="govuk-button-group">
          {{ govukButton({
            text: "Send query",
            disabled: user.isReadOnly,
            attributes: { "data-testid": "query-submit" }
          }) }}
          <a class="govuk-link"
             data-testid="query-cancel"
             href="{{ cancelHref }}">Cancel</a>
        </div>
      </form>
    </div>
  </div>
{% endblock %}

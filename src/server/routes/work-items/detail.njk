{% extends 'layouts/page.njk' %}

{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "action-link/macro.njk" import appActionLink %}

{# Shared row fragments — defined once and reused by both the AC02          #}
{# application-details rows and the previous-year section, which render the #}
{# same shapes.                                                             #}

{# One supporting document: a link when the file has passed the virus scan, #}
{# otherwise its name plus the scan-status tag. The `app-detail-document`   #}
{# testid is repeated (not indexed) so the e2e suite can count them and     #}
{# prove EVERY document renders, not just files[0] (AC02 item 7).           #}
{# `showUpdated` is opt-in: the upload hint carries the                     #}
{# `app-detail-sampling-updated-by` testid, which is the "S&I updated by"   #}
{# hook the e2e suite reads with a single-element lookup. BES-evidence      #}
{# files also carry `uploadedAt`, so rendering it for them too would        #}
{# duplicate that testid and let a BES occurrence satisfy an assertion      #}
{# about the sampling row. Only the sampling row opts in.                   #}
{% macro documentItem(file, showUpdated=false) %}
  <li>
    {% if file.href %}
      <a class="govuk-link"
         href="{{ file.href }}"
         data-testid="app-detail-document">{{ file.filename }}</a>
    {% else %}
      <span data-testid="app-detail-document">{{ file.filename }}</span>
      {{ govukTag({ text: file.scanStatus, classes: file.scanTagClass }) }}
    {% endif %}
    {% if showUpdated and (file.uploadedAt or file.uploadedBy) %}
      {# "S&I updated by" — retained per RA-295's Jira notes. #}
      <span class="govuk-hint govuk-!-margin-bottom-0"
            data-testid="app-detail-sampling-updated-by">Updated{% if file.uploadedAt %} {{ file.uploadedAt }}{% endif %}{% if file.uploadedBy %} by {{ file.uploadedBy }}{% endif %}</span>
    {% endif %}
  </li>
{% endmacro %}

{# RA-292. The "NEW: " prefix.                                              #}
{#                                                                          #}
{# DESIGN NOTE: the design is RATIFIED. The mock-ups show newness as a       #}
{# literal `NEW: ` prefix on the value itself — `NEW: Bharat Recycling` —    #}
{# not as a badge beside it, and the BA confirmed that on the ticket thread  #}
{# and asked for it in colour to make it prominent. Settled, not             #}
{# provisional. An earlier revision used a `govuk-tag--blue` reading "New",  #}
{# which was correct while no design existed (GDS is this service's default  #}
{# in that case) and is superseded now that one does. Do not revert it to a  #}
{# tag.                                                                      #}
{#                                                                          #}
{# The prefix is LITERAL TEXT, deliberately. It must not become a CSS        #}
{# ::before, a background image or anything else that conveys it by styling  #}
{# alone. The colour on `.app-new-flag` is ADDITIVE ONLY: strip the CSS and  #}
{# the word "NEW:" is still there for a colour-blind user, a screen-reader   #}
{# user, and anyone copying the value out. That is precisely what makes      #}
{# colouring it safe. The contrast working — measured against this page's    #}
{# GREY background, not white — is in `_work-items.scss`.                    #}
{#                                                                          #}
{# An icon was raised and deferred by the requester ("bigger fish to fry").  #}
{# If one is ever added it belongs inside this macro, beside the text and    #}
{# never replacing it. Do not build one speculatively.                       #}
{#                                                                          #}
{# The space after the colon is an ordinary ASCII space, NOT `&nbsp;`. A     #}
{# non-breaking space renders identically and would silently break every     #}
{# downstream `NEW: ` string assertion, so the wrapping it would prevent is  #}
{# not worth buying here.                                                    #}
{#                                                                          #}
{# Rendered ONLY when the flag is strictly true (the view model resolves     #}
{# that, not this macro), so a caller's `{% if %}` guard is the whole story: #}
{# absent means absent from the DOM, never merely hidden.                    #}
{% macro newPrefix(testId) %}<span class="app-new-flag" data-testid="{{ testId }}">NEW:</span> {% endmacro %}

{# RA-292 AC04. A site's detail fields as a nested borderless summary list. #}
{#                                                                          #}
{# `testIdPrefix` ("overseas-site" / "interim-site") plus the view model's   #}
{# own field key forms the value testid — e.g. `overseas-site-address`,     #}
{# which is also how the pre-RA-292 address hook keeps its exact name.      #}
{#                                                                          #}
{# Rows are omitted upstream when the field is absent, so there is no        #}
{# emptiness test here — and critically no truthiness test either: a         #}
{# `repatriatedLoads` of 0 and a `registeredNowAccredited` of false are      #}
{# answers a regulator needs, and a `{% if value %}` guard anywhere on this  #}
{# path would silently drop exactly those.                                   #}
{% macro siteDetails(details, testIdPrefix) %}
  {% if details.length %}
    <dl class="govuk-summary-list app-summary-list--borderless govuk-!-margin-bottom-2">
      {% for detail in details %}
        <div class="govuk-summary-list__row">
          <dt class="govuk-summary-list__key">{{ detail.label }}</dt>
          <dd class="govuk-summary-list__value"
              data-testid="{{ testIdPrefix }}-{{ detail.key }}">
            {% for line in detail.values %}
              <p class="govuk-body govuk-!-margin-bottom-0">{{ line }}</p>
            {% endfor %}
          </dd>
        </div>
      {% endfor %}
    </dl>
  {% endif %}
{% endmacro %}

{# One business-plan category: bold label, PRN-income share, narrative.     #}
{# `testId` is a parameter because the AC02 business-plan row and the       #}
{# previous-year section render the same shape but are counted separately — #}
{# stamping `app-detail-pair` on both would make an AC02 pair count also    #}
{# pick up prior-year pairs.                                                #}
{% macro businessPlanPair(pair, testId='app-detail-pair') %}
  <p class="govuk-body govuk-!-margin-bottom-1" data-testid="{{ testId }}">
    <strong>{{ pair.label }}</strong>{% if pair.percent %} — {{ pair.percent }}{% endif %}{% if pair.detail %}<br>{{ pair.detail }}{% endif %}
  </p>
{% endmacro %}

{# ---------------------------------------------------------------- #}
{# Generic work item detail template — "Application summary" tab.     #}
{#                                                                   #}
{# Used as the fallback when the work item's `(typeId,               #}
{# templateVersion)` pair has no module-specific template registered. #}
{#                                                                   #}
{# RA-295 realigned the page to the case-management prototype:        #}
{#  - the case header (AC01) is rendered full-bleed by the layout     #}
{#    from the `caseHeader` view model, so there is no page heading   #}
{#    here and no green RA-98 notification banner;                    #}
{#  - "Application summary" / "Application history" tabs sit above    #}
{#    the body;                                                       #}
{#  - ALL submitted application data is on this one page in the AC02  #}
{#    order (the two-step application-details page is gone);          #}
{#  - assignment and the available actions live in bordered panels in #}
{#    the right-hand third (AC03);                                    #}
{#  - the application ref / provenance block is retained for          #}
{#    debugging but demoted to the bottom of the page.                #}
{#                                                                   #}
{# GOV.UK Design System macros only — no JavaScript (RA-94), and the  #}
{# grid columns give the responsive behaviour AC05 requires.          #}
{# ---------------------------------------------------------------- #}

{% block content %}
  {{ appCaseTabs({ tabs: caseTabs }) }}

  {# RA-132. Generic flash-banner rendered above the existing per-feature  #}
  {# banners. Set by handlers via `request.yar.flash('flashBanner', ...)`  #}
  {# with shape `{type: 'success' | 'error', title?, text}`.                #}
  {% if flashBanner %}
    {{ govukNotificationBanner({
      type: flashBanner.type,
      titleText: flashBanner.title or (flashBanner.type == 'success' and 'Success' or 'There is a problem'),
      text: flashBanner.text,
      attributes: { "data-testid": "work-item-flash-banner" }
    }) }}
  {% endif %}

  {# RA-219: `successBanner` is only ever flashed with a truthy `reference`   #}
  {# (the create controller falls back to the work item id and suppresses    #}
  {# the banner entirely when even that is missing), so the banner can never  #}
  {# render a dangling "Work item created — " / "Reference: " line.           #}
  {% if successBanner and successBanner.reference %}
    {{ govukNotificationBanner({
      type: 'success',
      titleText: 'Work item created — ' + successBanner.reference,
      text: 'Reference: ' + successBanner.reference,
      attributes: { "data-testid": "work-item-success-banner" }
    }) }}
  {% endif %}

  {% if notice %}
    {% if notice.kind == 'error' %}
      {{ govukErrorSummary({
        titleText: notice.title or "There is a problem",
        errorList: [{ text: notice.message }]
      }) }}
    {% else %}
      {{ govukNotificationBanner({
        type: 'success',
        titleText: notice.title or 'Success',
        text: notice.message
      }) }}
    {% endif %}
  {% endif %}

  {# RA-358. Withdrawn applications are never deleted by management-be —   #}
  {# `GET /work-items/{id}` returns a normal 200 for them — so this page   #}
  {# has to state the withdrawal itself rather than leaving it to the grey #}
  {# state tag and the read-only Outcome panel.                            #}
  {#                                                                       #}
  {# Rendered as an error summary, not a notification banner, for the same #}
  {# reason as the RA-211 banner below: govukNotificationBanner only       #}
  {# honours type 'success', and core/_header.scss sets                    #}
  {# --govuk-brand-colour to Defra green service-wide, so any other banner  #}
  {# comes out green and reads as good news. disableAutoFocus because the  #}
  {# notice persists across every visit to a withdrawn case and must not   #}
  {# steal focus each time.                                                #}
  {#                                                                       #}
  {# RA-249: the case is named by its human application reference or not   #}
  {# at all — never by the work-item Guid.                                 #}
  {#                                                                       #}
  {# The sentence is composed in a `{% set %}` BLOCK CAPTURE, not by       #}
  {# concatenating an HTML string. govuk-frontend renders an error-summary #}
  {# item's `html` through `| safe`, so a hand-built string would need a   #}
  {# hand-placed `| escape` on the reference and would be one deleted      #}
  {# filter away from stored XSS on backend-controlled data. Inside a      #}
  {# block capture `{{ withdrawnNotice.applicationRef }}` goes through     #}
  {# normal autoescaping (the env sets `autoescape: true`), so there is no #}
  {# manual filter to drop. All prose comes from the constants in          #}
  {# core/withdrawn-notice.js so the referenced and unreferenced variants  #}
  {# cannot drift apart.                                                   #}
  {#                                                                       #}
  {# The whitespace below is LOAD-BEARING — it is the spacing of the       #}
  {# rendered sentence, not indentation — so the capture uses explicit     #}
  {# `{{-` / `-%}` trim markers to strip the line breaks while keeping the #}
  {# two significant single spaces (before `<strong>`, and before the      #}
  {# tail). `detail.controller.test.js` pins the fully composed referenced #}
  {# sentence as one exact string, so any accidental change here fails.    #}
  {#                                                                       #}
  {# `data-testid` hooks are an EXTERNAL CONTRACT consumed by the          #}
  {# epr-register-enrol-mgmt-tests WebdriverIO suite — renaming            #}
  {# `work-item-withdrawn-notice` or `work-item-withdrawn-reference`       #}
  {# breaks journey specs in that repo, which is branch-matched to this    #}
  {# one by exact branch name. Coordinate before changing them.            #}
  {% if withdrawnNotice %}
    {% set withdrawnNoticeHtml %}
      {{- withdrawnNotice.subject -}}
      {%- if withdrawnNotice.applicationRef %} <strong data-testid="work-item-withdrawn-reference">{{ withdrawnNotice.applicationRef }}</strong>{% endif %} {{ withdrawnNotice.tail -}}
    {% endset %}
    {{ govukErrorSummary({
      titleText: withdrawnNotice.title,
      errorList: [{ html: withdrawnNoticeHtml }],
      disableAutoFocus: true,
      attributes: { "data-testid": "work-item-withdrawn-notice" }
    }) }}
  {% endif %}

  {# RA-211: surfaces when the audit log has an unresolved                #}
  {# notification-failed entry (no later notification-sent).              #}
  {# govukNotificationBanner only honours type: 'success' — any other     #}
  {# type renders the default brand-coloured banner, and core/_header.scss #}
  {# sets --govuk-brand-colour to Defra green service-wide, so an "error"  #}
  {# banner came out green and read as a success message. Use the same    #}
  {# red error summary as the notice.kind == 'error' branch above.         #}
  {# disableAutoFocus because this banner persists across every visit to   #}
  {# the page, so it must not steal focus on each load.                    #}
  {% if notificationFailedBanner %}
    {{ govukErrorSummary({
      titleText: 'There is a problem',
      errorList: [{ text: 'A notification email for this application could not be sent. Check the application history for details.' }],
      disableAutoFocus: true,
      attributes: { "data-testid": "work-item-notification-failed-banner" }
    }) }}
  {% endif %}

  <div class="govuk-grid-row">
    {# ==================== Application information ==================== #}
    <div class="govuk-grid-column-two-thirds">
      {# Block for type-specific content rendered ABOVE the application    #}
      {# details — used by RA-177 to surface the re-accreditation "issued" #}
      {# confirmation panel as the first thing the user sees after         #}
      {# approving.                                                        #}
      {% block summaryListBefore %}{% endblock %}

      <h2 class="govuk-heading-m">Application details</h2>

      {# RA-295 AC02. One ordered container; every row is a direct sibling #}
      {# in the AC02 order so the order itself is assertable. Borderless   #}
      {# per the prototype (no dividing rules between rows).               #}
      <dl class="govuk-summary-list app-summary-list--borderless"
          data-testid="application-details">
        {% for row in applicationDetails %}
          <div class="govuk-summary-list__row"
               data-testid="app-detail-row-{{ row.key }}">
            <dt class="govuk-summary-list__key">{{ row.label }}</dt>
            <dd class="govuk-summary-list__value"
                data-testid="app-detail-value-{{ row.key }}">

              {% if row.kind == 'text' %}
                {{ row.value }}

              {% elif row.kind == 'lines' %}
                {% for line in row.values %}
                  <p class="govuk-body govuk-!-margin-bottom-1"
                     data-testid="app-detail-line">{{ line }}</p>
                {% else %}
                  —
                {% endfor %}

              {% elif row.kind == 'files' %}
                {% if row.files.length %}
                  <ul class="govuk-list">
                    {# Only the sampling & inspection plan shows the upload   #}
                    {# hint — see the macro's `showUpdated` note.            #}
                    {% for file in row.files %}{{ documentItem(file, row.key == 'sampling-inspection-plan') }}{% endfor %}
                  </ul>
                {% else %}
                  <span data-testid="app-detail-documents-none">No documents uploaded.</span>
                {% endif %}

              {% elif row.kind == 'pairs' %}
                {% for pair in row.pairs %}{{ businessPlanPair(pair) }}
                {% else %}
                  —
                {% endfor %}

              {% elif row.kind == 'bes-sites' %}
                {# BES evidence, grouped by the site it evidences. The block  #}
                {# testid is `bes-site`, NOT `overseas-site` — see the        #}
                {# `bes-sites` note in application-summary.js.                #}
                {% for site in row.sites %}
                  <div data-testid="bes-site">
                    <p class="govuk-body govuk-!-margin-bottom-1">
                      <strong>{{ site.siteName }}</strong>{% if site.country %} ({{ site.country }}){% endif %}
                    </p>
                    {% if site.files.length %}
                      <ul class="govuk-list">
                        {% for file in site.files %}{{ documentItem(file) }}{% endfor %}
                      </ul>
                    {% endif %}
                  </div>
                {% else %}
                  —
                {% endfor %}

              {% elif row.kind == 'overseas-sites' %}
                {# RA-292 AC01 + AC02 + AC04. One block per overseas site:    #}
                {# name (+ "New" tag), the full site detail, and the interim  #}
                {# site NESTED inside its parent — an interim site belongs to #}
                {# an ORS rather than standing beside it, and the nesting is  #}
                {# what tells a regulator which ORS a given interim site      #}
                {# serves when an application declares several.               #}
                {% for site in row.sites %}
                  <div class="govuk-!-margin-bottom-4" data-testid="overseas-site">
                    {# Name line then address line — the design's shape. The  #}
                    {# `NEW:` prefix is nested INSIDE the name element, so    #}
                    {# that element's text is the full "NEW: <name>" string   #}
                    {# and a prefix assertion scoped to it cannot be          #}
                    {# satisfied by a nested interim site's prefix.           #}
                    <p class="govuk-body govuk-!-margin-bottom-1"
                       data-testid="overseas-site-name">
                      <strong>{% if site.isNew %}{{ newPrefix('overseas-site-new-tag') }}{% endif %}{{ site.siteName }}</strong>
                    </p>
                    {# One flowing comma-separated line, per the design — and #}
                    {# ONE element, so an e2e assertion reads the whole       #}
                    {# address rather than silently matching its first part.  #}
                    {# The parts stay an array until here precisely so the    #}
                    {# de-duplication can work segment-wise; see              #}
                    {# `appendUnseen` in application-summary.js.              #}
                    {% if site.addressLines.length %}
                      <p class="govuk-body govuk-!-margin-bottom-1"
                         data-testid="overseas-site-address">{{ site.addressLines | join(', ') }}</p>
                    {% endif %}
                    {{ siteDetails(site.details, 'overseas-site') }}
                    {% if site.interimSite %}
                      <div class="govuk-inset-text govuk-!-margin-top-0 govuk-!-margin-bottom-0"
                           data-testid="interim-site">
                        {# Sub-label per the design, on its own line above  #}
                        {# the site name. The PLURAL is deliberate and        #}
                        {# matches the mockup, confirmed with Tom, even       #}
                        {# though the data model allows at most one interim   #}
                        {# site per ORS and it reads slightly oddly with a    #}
                        {# single child. Do not "correct" it to singular.     #}
                        {# It carries no testid: the e2e suite reads          #}
                        {# `interim-site-name` for the name line, and putting #}
                        {# the label inside that element would push `NEW: `   #}
                        {# off position 0 and break its prefix check.         #}
                        <p class="govuk-body govuk-!-margin-bottom-1"><strong>Interim sites</strong></p>
                        <p class="govuk-body govuk-!-margin-bottom-1"
                           data-testid="interim-site-name">
                          <strong>{% if site.interimSite.isNew %}{{ newPrefix('interim-site-new-tag') }}{% endif %}{{ site.interimSite.siteName }}</strong>
                        </p>
                        {% if site.interimSite.addressLines.length %}
                          <p class="govuk-body govuk-!-margin-bottom-1"
                             data-testid="interim-site-address">{{ site.interimSite.addressLines | join(', ') }}</p>
                        {% endif %}
                        {{ siteDetails(site.interimSite.details, 'interim-site') }}
                      </div>
                    {% endif %}
                  </div>
                {% else %}
                  —
                {% endfor %}

              {% elif row.kind == 'authority-contacts' %}
                {# RA-292 AC03. The contact text is unchanged from the        #}
                {# previous `lines` rendering ("Name (email)"), so anything   #}
                {# asserting on this row's text still passes; what is new is  #}
                {# the per-contact block and its "New" tag.                   #}
                {# The prefix sits OUTSIDE `authority-to-issue-contact-name`, #}
                {# unlike the site blocks. That element means "the contact's  #}
                {# name" and is read as a value, so folding "NEW:" into it    #}
                {# would make its text stop being the name. The line-level    #}
                {# element is `authority-to-issue-contact`, and that is where #}
                {# the full "NEW: <name> (<email>)" string lives.             #}
                {% for contact in row.contacts %}
                  <p class="govuk-body govuk-!-margin-bottom-1"
                     data-testid="authority-to-issue-contact">
                    {% if contact.isNew %}{{ newPrefix('authority-to-issue-new-tag') }}{% endif %}<span data-testid="authority-to-issue-contact-name">{{ contact.name }}</span>{% if contact.email %} ({{ contact.email }}){% endif %}
                  </p>
                {% else %}
                  —
                {% endfor %}
              {% endif %}

            </dd>
          </div>
        {% endfor %}
      </dl>

      {# RA-254. Prior-year accreditation reference data, when the backend  #}
      {# can supply it. Additive and failure-tolerant: absent when the      #}
      {# lookup fails, so it can never block the page.                      #}
      {% if priorYear %}
        <h2 class="govuk-heading-m" data-testid="prior-year-heading">
          Previous year ({{ priorYear.year }})
        </h2>
        <dl class="govuk-summary-list app-summary-list--borderless"
            data-testid="prior-year-details">
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">PRN tonnage</dt>
            <dd class="govuk-summary-list__value"
                data-testid="prior-year-tonnage">{{ priorYear.tonnageBand }}</dd>
          </div>
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">PRN authorisers</dt>
            <dd class="govuk-summary-list__value" data-testid="prior-year-authorisers">
              {% for line in priorYear.authoriserLines %}
                <p class="govuk-body govuk-!-margin-bottom-1">{{ line }}</p>
              {% else %}
                —
              {% endfor %}
            </dd>
          </div>
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Business plan</dt>
            <dd class="govuk-summary-list__value" data-testid="prior-year-business-plan">
              {% for pair in priorYear.businessPlanPairs %}{{ businessPlanPair(pair, 'prior-year-pair') }}
              {% else %}
                —
              {% endfor %}
            </dd>
          </div>
        </dl>
      {% endif %}

      {# Block for type-specific content rendered immediately below the     #}
      {# application details.                                               #}
      {% block summaryListExtra %}{% endblock %}
    </div>

    {# ======================= Right-hand panels ======================= #}
    <div class="govuk-grid-column-one-third">
      {# Block for type-specific primary actions rendered above the        #}
      {# assignment panel.                                                 #}
      {% block primaryActions %}{% endblock %}

      {# -------------------------- Assignment -------------------------- #}
      {# RA-295 AC03. Assignment lives in the bordered right-hand panel,   #}
      {# and every affordance is available in every state: a primary       #}
      {# "Assign to yourself and start" button, then the reassign /        #}
      {# unassign / due-date links. RA-323: every caseworker has the same  #}
      {# permissions; the backend remains the source of truth and rejects  #}
      {# anything the caller may not do.                                   #}
      <div class="app-case-panel" data-testid="case-assignment-panel">
        {# RA-295. No heading in the prototype — the card is identified by    #}
        {# its primary button. The assignee is already the case header's      #}
        {# "Assigned to" field (AC01), so it is only repeated here when the   #}
        {# item is actually assigned: the prototype's unassigned card shows   #}
        {# no status line at all, and "Unassigned" here only restates the     #}
        {# header directly above the button that resolves it.                 #}
        {% if assignment.callerIsAssignee or assignment.assignedToName %}
          <p class="govuk-body" data-testid="assignment-current">
            {% if assignment.callerIsAssignee %}
              Assigned to you
            {% else %}
              Assigned to {{ assignment.assignedToName }}
            {% endif %}
          </p>
        {% endif %}

        {# RA-358. Once the case is closed (approved / rejected / withdrawn)   #}
        {# NO assignment affordance renders — not an inert RA-335 span, but   #}
        {# absent. RA-335's greyed span says "this action is not for YOU";    #}
        {# here the action is meaningless for everyone, so offering it in any #}
        {# form is the wrong message. management-be rejects assign/unassign   #}
        {# on a terminal item with 409 TerminalState, so this gate only stops #}
        {# the UI offering what can only fail — it is not the enforcement     #}
        {# point. See buildAssignmentViewModel for what RA-295 AC03 traded    #}
        {# away.                                                              #}
        {#                                                                    #}
        {# The replacement line is a POSITIVE hook on purpose: asserting only #}
        {# the absence of the three affordances would pass vacuously if this  #}
        {# panel ever failed to render at all. The mgmt-tests suite asserts   #}
        {# `assignment-closed` present AND the affordances absent.            #}
        {% if assignment.isClosed %}
          <p class="govuk-body govuk-!-margin-bottom-0"
             data-testid="assignment-closed">
            This application is closed. It cannot be assigned or reassigned.
          </p>
        {% else %}
        {% if assignment.canSelfAssign %}
          <form method="post"
                action="/work-items/{{ workItem.id }}/self-assign"
                novalidate>
            <input type="hidden" name="crumb" value="{{ crumb }}" />
            {{ govukButton({
              text: "Assign to yourself and start",
              classes: "app-case-panel__primary-action govuk-!-margin-bottom-0",
              disabled: user.isReadOnly,
              attributes: { "data-testid": "self-assign-submit" }
            }) }}
          </form>
        {% endif %}

        <hr class="app-case-panel__divider">

        {# RA-335: rendered via appActionLink so a read-only support user's   #}
        {# session gets an inert (unclickable, non-navigating) span instead   #}
        {# of a live link — see action-link/macro.njk.                       #}
        <ul class="app-case-panel__links">
          <li>
            {{ appActionLink({
              text: "Reassign the application",
              href: "/work-items/" + workItem.id + "/assign",
              classes: "govuk-link",
              disabled: user.isReadOnly,
              testId: "reassign-link"
            }) }}
          </li>
          <li>
            {{ appActionLink({
              text: "Unassign the application",
              href: "/work-items/" + workItem.id + "/unassign",
              classes: "govuk-link",
              disabled: user.isReadOnly,
              testId: "unassign-link"
            }) }}
          </li>
          {# RA-131's Extend / Override SLA affordances, relabelled to the   #}
          {# prototype's wording. Testids unchanged so existing journeys     #}
          {# keep working. Gated on the engine still projecting `sla-extend` #}
          {# — see `canChangeDueDate` in the controller: the backend has no  #}
          {# terminal-state check of its own, so an ungated link would let a #}
          {# caseworker move the due date on a closed case.                   #}
          {% if workItem.canChangeDueDate %}
            <li>
              {{ appActionLink({
                text: "Change the due date",
                href: "/work-items/" + workItem.id + "/sla/extend",
                classes: "govuk-link",
                disabled: user.isReadOnly,
                testId: "action-sla-extend"
              }) }}
            </li>
            <li>
              {{ appActionLink({
                text: "Override the due date",
                href: "/work-items/" + workItem.id + "/sla/override",
                classes: "govuk-link",
                disabled: user.isReadOnly,
                testId: "action-sla-override"
              }) }}
            </li>
          {% endif %}
        </ul>
        {% endif %}
      </div>

      {# ---------------------------- Actions ---------------------------- #}
      {# Wrapped in an override-able block so type-specific templates can   #}
      {# replace the generic action list — used by RA-132 to suppress       #}
      {# decision actions once a re-accreditation reaches a terminal state. #}
      <div class="app-case-panel" data-testid="actions-panel">
        {% block actionsPanel %}
        {# RA-295. The prototype's action card carries no "Actions" heading:  #}
        {# a full-width primary button, then Query and Withdraw as a single   #}
        {# row of secondary links (Query left, Withdraw right, destructive    #}
        {# red). Withdraw is a LINK here, not a warning button — it still     #}
        {# goes through the RA-188 confirmation interstitial, so no state     #}
        {# changes on the click.                                              #}
        {% if workItem.availableActions and workItem.availableActions.length > 0 %}
          <div data-testid="work-item-actions">
            {# `sla-extend` is filtered out of `availableActions` by the     #}
            {# controller (it renders as "Change the due date" in the        #}
            {# assignment panel), so it never reaches this loop and the      #}
            {# length check above stays honest.                              #}

            {# Primary actions — full-width buttons, stacked. #}
            {% for action in workItem.availableActions %}
              {% if not (action.actionId == 'query' or action.actionId.startsWith('query-')
                         or action.actionId == 'withdraw' or action.actionId.startsWith('withdraw-')) %}
                <form method="post"
                      action="/work-items/{{ workItem.id }}/actions/{{ action.actionId }}"
                      novalidate>
                  <input type="hidden" name="crumb" value="{{ crumb }}" />
                  {{ govukButton({
                    text: action.displayName,
                    classes: "app-case-panel__primary-action" + (action.actionId == 'reject' and ' govuk-button--warning' or ''),
                    disabled: user.isReadOnly,
                    attributes: { "data-testid": "action-" + action.actionId }
                  }) }}
                </form>
              {% endif %}
            {% endfor %}

            {# Secondary link row. RA-335: rendered via appActionLink so a  #}
            {# read-only support user's session gets an inert span rather   #}
            {# than a live link — see action-link/macro.njk.                #}
            <div class="app-case-panel__action-links">
              {% for action in workItem.availableActions %}
                {% if action.actionId == 'query' or action.actionId.startsWith('query-') %}
                  {{ appActionLink({
                    text: "Query",
                    href: "/work-items/" + workItem.id + "/query",
                    classes: "govuk-link",
                    disabled: user.isReadOnly,
                    testId: "action-query"
                  }) }}
                {% endif %}
              {% endfor %}
              {# RA-317. Withdraw is an OPERATOR action and must not appear in  #}
              {# Case Management. The link row that rendered it (and the        #}
              {# RA-188 confirmation interstitial it pointed at) is removed.    #}
              {# The primary-actions loop above already excludes withdraw ids,  #}
              {# and the generic apply-action route rejects them server-side,   #}
              {# so no withdraw affordance renders in any state. The Withdrawn  #}
              {# STATUS notice/tag (AC03) is unaffected — it lives in the       #}
              {# withdrawn-notice block and the terminal-state Outcome panel.   #}
            </div>
          </div>
        {% else %}
          <p class="govuk-body" data-testid="work-item-no-actions">
            No actions are currently available for this work item.
          </p>
        {% endif %}
        {% endblock %}
      </div>

    </div>
  </div>

  {# ------------------------- Reference footer ------------------------- #}
  {# RA-295. The application ref / work item id are retained for debugging #}
  {# but demoted to the bottom of the page, together with the envelope and #}
  {# operator-reference fields that used to live on the standalone         #}
  {# application-details page — so folding that page in loses no data.     #}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <div class="app-case-footer">
        <h2 class="govuk-heading-s">Reference</h2>
        <dl class="govuk-summary-list app-summary-list--borderless govuk-!-font-size-16"
            data-testid="work-item-application-ref-footer">
          {% for row in caseFooterRows %}
            <div class="govuk-summary-list__row"
                 data-testid="work-item-reference-row-{{ row.key }}">
              <dt class="govuk-summary-list__key">{{ row.label }}</dt>
              <dd class="govuk-summary-list__value">{{ row.value }}</dd>
            </div>
          {% endfor %}
        </dl>
      </div>
    </div>
  </div>
{% endblock %}

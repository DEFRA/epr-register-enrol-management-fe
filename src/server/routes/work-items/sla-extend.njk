{% extends 'layouts/page.njk' %}

{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/date-input/macro.njk" import govukDateInput %}
{% from "govuk/components/character-count/macro.njk" import govukCharacterCount %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{# RA-131: Extend the determination deadline. Relabelled from "SLA" to      #}
{# "Determination Deadline" and moved from a day-count input to a calendar  #}
{# date picker with no upper bound by RA-447 (CM5 / CM6) — see              #}
{# `sla.service.js#validateExtendDeadline`. `data-testid`s are unchanged.   #}

{% block content %}
  {{ appHeading({
    text: heading,
    caption: "Work item " + workItem.applicationRef
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      {% if errorSummary %}
        {{ govukErrorSummary({
          titleText: errorSummary.titleText,
          errorList: errorSummary.items,
          attributes: { "data-testid": "sla-extend-error-summary" }
        }) }}
      {% endif %}

      <form method="post"
            action="{{ formAction }}"
            novalidate
            data-testid="sla-extend-form">
        <input type="hidden" name="crumb" value="{{ crumb }}" />

        {{ govukCharacterCount({
          id: "field-reason",
          name: "reason",
          maxlength: reasonMaxLength,
          label: {
            text: "Reason for extending the determination deadline",
            classes: "govuk-label--s"
          },
          hint: {
            text: "Explain why the determination deadline needs to be extended."
          },
          value: values.reason,
          errorMessage: { text: fieldErrors["reason"] } if fieldErrors["reason"] else null,
          attributes: { "data-testid": "sla-extend-reason" }
        }) }}

        {{ govukDateInput({
          id: dateInputId,
          namePrefix: dateInputId,
          fieldset: {
            legend: {
              text: "New determination deadline",
              classes: "govuk-fieldset__legend--s"
            }
          },
          hint: { text: "For example, 27 3 2026" },
          items: [
            {
              name: "day",
              classes: "govuk-input--width-2" + (" govuk-input--error" if fieldErrors["deadline"] else ""),
              value: values.deadline.day
            },
            {
              name: "month",
              classes: "govuk-input--width-2" + (" govuk-input--error" if fieldErrors["deadline"] else ""),
              value: values.deadline.month
            },
            {
              name: "year",
              classes: "govuk-input--width-4" + (" govuk-input--error" if fieldErrors["deadline"] else ""),
              value: values.deadline.year
            }
          ],
          errorMessage: { text: fieldErrors["deadline"] } if fieldErrors["deadline"] else null,
          attributes: { "data-testid": "sla-extend-days" }
        }) }}

        <div class="govuk-button-group">
          {{ govukButton({
            text: "Extend determination deadline",
            disabled: user.isReadOnly,
            attributes: { "data-testid": "sla-extend-submit" }
          }) }}
          <a class="govuk-link"
             data-testid="sla-extend-cancel"
             href="{{ cancelHref }}">Cancel</a>
        </div>
      </form>
    </div>
  </div>
{% endblock %}

{# ------------------------------------------------------------------- #}
{# Summary fragments shared by the work item detail templates: the     #}
{# generic (re-accreditation) Application summary in `detail.njk`, the  #}
{# add-ORS one in `add-overseas-site/detail-v1.njk` (RA-739) and the     #}
{# Accreditation summary tab in `accreditation-summary.njk` (RA-769).    #}
{# ------------------------------------------------------------------- #}

{% from "govuk/components/tag/macro.njk" import govukTag %}

{# RA-292. The "NEW: " prefix. RA-495: the add-ORS summary marks the    #}
{# values the operator supplied on the request with it too.             #}
{#                                                                          #}
{# DESIGN NOTE: the design is RATIFIED. The mock-ups show newness as a       #}
{# literal `NEW: ` prefix on the value itself — `NEW: Bharat Recycling` —    #}
{# not as a badge beside it, and the BA confirmed that on the ticket thread  #}
{# and asked for it in colour to make it prominent. Settled, not             #}
{# provisional. An earlier revision used a `govuk-tag--blue` reading "New",  #}
{# which was correct while no design existed (GDS is this service's default  #}
{# in that case) and is superseded now that one does. Do not revert it to a  #}
{# tag.                                                                      #}
{#                                                                          #}
{# The prefix is LITERAL TEXT, deliberately. It must not become a CSS        #}
{# ::before, a background image or anything else that conveys it by styling  #}
{# alone. The colour on `.app-new-flag` is ADDITIVE ONLY: strip the CSS and  #}
{# the word "NEW:" is still there for a colour-blind user, a screen-reader   #}
{# user, and anyone copying the value out. That is precisely what makes      #}
{# colouring it safe. The contrast working — measured against this page's    #}
{# GREY background, not white — is in `_work-items.scss`.                    #}
{#                                                                          #}
{# An icon was raised and deferred by the requester ("bigger fish to fry").  #}
{# If one is ever added it belongs inside this macro, beside the text and    #}
{# never replacing it. Do not build one speculatively.                       #}
{#                                                                          #}
{# The space after the colon is an ordinary ASCII space, NOT `&nbsp;`. A     #}
{# non-breaking space renders identically and would silently break every     #}
{# downstream `NEW: ` string assertion, so the wrapping it would prevent is  #}
{# not worth buying here.                                                    #}
{#                                                                          #}
{# Rendered ONLY when the flag is strictly true (the view model resolves     #}
{# that, not this macro), so a caller's `{% if %}` guard is the whole story: #}
{# absent means absent from the DOM, never merely hidden.                    #}
{% macro newPrefix(testId) %}<span class="app-new-flag" data-testid="{{ testId }}">NEW:</span> {% endmacro %}

{# One supporting document: a link when the file has passed the virus scan, #}
{# otherwise its name plus the scan-status tag. The `app-detail-document`   #}
{# testid is repeated (not indexed) so the e2e suite can count them and     #}
{# prove EVERY document renders, not just files[0] (AC02 item 7).           #}
{# `showUpdated` is opt-in: the upload hint carries the                     #}
{# `app-detail-sampling-updated-by` testid, which is the "S&I updated by"   #}
{# hook the e2e suite reads with a single-element lookup. BES-evidence      #}
{# files also carry `uploadedAt`, so rendering it for them too would        #}
{# duplicate that testid and let a BES occurrence satisfy an assertion      #}
{# about the sampling row. Only the sampling row opts in.                   #}
{# `showDates` is opt-in too (RA-739): the add-ORS BES files show their     #}
{# valid-from and expiry dates, from the view model's `validFrom` and       #}
{# `expiryDate`.                                                            #}
{# `newTestId` (3bb.13) puts the "NEW: " prefix, with that testid, before    #}
{# the file: the add-ORS summary marks the first BES file when the operator  #}
{# uploaded the evidence on the request.                                     #}
{# `newTag` (RA-782) puts a purple "New" tag after the file: the ORS update   #}
{# summary marks the BES files the update adds.                             #}
{% macro documentItem(file, showUpdated=false, showDates=false, newTestId='', newTag=false) %}
  <li>
    {% if newTestId %}{{ newPrefix(newTestId) }}{% endif %}
    {% if file.href %}
      <a class="govuk-link"
         href="{{ file.href }}"
         data-testid="app-detail-document">{{ file.filename }}</a>
    {% else %}
      <span data-testid="app-detail-document">{{ file.filename }}</span>
      {{ govukTag({ text: file.scanStatus, classes: file.scanTagClass }) }}
    {% endif %}
    {% if newTag %}
      {{ govukTag({ text: "New", classes: "govuk-tag--purple", attributes: { "data-testid": "app-detail-document-new" } }) }}
    {% endif %}
    {% if showUpdated and (file.uploadedAt or file.uploadedBy) %}
      {# "S&I updated by" — retained per RA-295's Jira notes. #}
      <span class="govuk-hint govuk-!-margin-bottom-0"
            data-testid="app-detail-sampling-updated-by">Updated{% if file.uploadedAt %} {{ file.uploadedAt }}{% endif %}{% if file.uploadedBy %} by {{ file.uploadedBy }}{% endif %}</span>
    {% endif %}
    {% if showDates %}
      <p class="govuk-body-s govuk-!-margin-top-1 govuk-!-margin-bottom-0"
         data-testid="app-detail-document-valid-from">Valid from: {{ file.validFrom }}</p>
      <p class="govuk-body-s govuk-!-margin-bottom-0"
         data-testid="app-detail-document-expiry-date">Expiry date: {{ file.expiryDate }}</p>
    {% endif %}
  </li>
{% endmacro %}

{# RA-292 AC04. A site's detail fields as a nested summary list,           #}
{# borderless.                                                              #}
{#                                                                          #}
{# `testIdPrefix` ("overseas-site" / "interim-site") plus the view model's   #}
{# own field key forms the value testid — e.g. `overseas-site-address`,     #}
{# which is also how the pre-RA-292 address hook keeps its exact name.      #}
{#                                                                          #}
{# Which rows render is decided upstream (re-accreditation omits an absent  #}
{# field; add-ORS shows the dash), so there is no emptiness test here — and #}
{# critically no truthiness test either: a                                  #}
{# `repatriatedLoads` of 0 and a `registeredNowAccredited` of false are      #}
{# answers a regulator needs, and a `{% if value %}` guard anywhere on this  #}
{# path would silently drop exactly those.                                   #}
{% macro siteDetails(details, testIdPrefix) %}
  {% if details.length %}
    <dl class="govuk-summary-list app-summary-list--borderless govuk-!-margin-bottom-2">
      {% for detail in details %}
        <div class="govuk-summary-list__row">
          <dt class="govuk-summary-list__key">{{ detail.label }}</dt>
          <dd class="govuk-summary-list__value"
              data-testid="{{ testIdPrefix }}-{{ detail.key }}">
            {% for line in detail.values %}
              <p class="govuk-body govuk-!-margin-bottom-0">{{ line }}</p>
            {% endfor %}
          </dd>
        </div>
      {% endfor %}
    </dl>
  {% endif %}
{% endmacro %}

{# The overseas site list and each site's nested interim sites, shared so  #}
{# another summary can reuse them (RA-769). The defaults are the           #}
{# re-accreditation output. The `data-testid` hooks are a contract with    #}
{# mgmt-tests.                                                             #}
{#                                                                          #}
{# A site carrying `siteNumber` shows it before its name (RA-769).         #}
{# Whether the condensed address shows is decided by the view model: only   #}
{# for a site whose name repeats in the list (`buildOverseasSites`).        #}
{% macro overseasSiteList(sites) %}
  {# RA-292 AC01 + AC02 + AC04. One block per overseas site:    #}
  {# name (+ "New" tag), the full site detail, and the interim  #}
  {# site NESTED inside its parent — an interim site belongs to #}
  {# an ORS rather than standing beside it, and the nesting is  #}
  {# what tells a regulator which ORS a given interim site      #}
  {# serves when an application declares several.               #}
  {# Wrapped in a native <details> per site (collapsed by       #}
  {# default) so a regulator scanning an application with many  #}
  {# sites sees names and condensed addresses, expanding one   #}
  {# time rather than scrolling past every field of every site. #}
  {% for site in sites %}
    <details class="govuk-details govuk-!-margin-bottom-2" data-testid="overseas-site">
      <summary class="govuk-details__summary">
        {# Name line — the design's shape, now doubling as the  #}
        {# details summary. The `NEW:` prefix is nested INSIDE  #}
        {# the name element, so that element's text is the full #}
        {# "NEW: <name>" string and a prefix assertion scoped   #}
        {# to it cannot be satisfied by a nested interim site's #}
        {# prefix.                                              #}
        {# RA-769: an optional site number ahead of the name, in    #}
        {# its own element so the name element is unchanged.        #}
        <span class="govuk-details__summary-text">
          {% if site.siteNumber %}<span data-testid="overseas-site-number">{{ site.siteNumber }} </span>{% endif %}
          <span data-testid="overseas-site-name">
            <strong>{% if site.isNew %}{{ newPrefix('overseas-site-new-tag') }}{% endif %}{{ site.siteName }}</strong>
          </span>
          {% if site.summaryAddress %}
            <br>
            <span data-testid="overseas-site-summary-address">{{ site.summaryAddress }}</span>
          {% endif %}
        </span>
      </summary>
      <div class="govuk-details__text">
        {# One flowing comma-separated line, per the design — and #}
        {# ONE element, so an e2e assertion reads the whole       #}
        {# address rather than silently matching its first part.  #}
        {# The parts stay an array until here precisely so the    #}
        {# de-duplication can work segment-wise; see              #}
        {# `appendUnseen` in application-summary.js.              #}
        {% if site.addressLines.length %}
          <p class="govuk-body govuk-!-margin-bottom-1"
             data-testid="overseas-site-address">{{ site.addressLines | join(', ') }}</p>
        {% endif %}
        {{ siteDetails(site.details, 'overseas-site') }}
        {% if site.interimSites.length %}
          {# RA-603 AC10b: an ORS can carry several interim     #}
          {# sites, each folding down on its own so a regulator #}
          {# can open one without wading through the rest.      #}
          {# Nested <details> inside the ORS's own <details> -   #}
          {# valid, and it works without JavaScript, which a    #}
          {# nested govuk-accordion would not.                  #}
          <div class="govuk-inset-text govuk-!-margin-top-0 govuk-!-margin-bottom-0"
               data-testid="interim-sites">
            {# Sub-label per the design. The PLURAL was          #}
            {# deliberate even when only one interim site was    #}
            {# possible, confirmed with Tom - it is now simply   #}
            {# accurate. The count tells a regulator how many    #}
            {# are folded away before they open any of them,     #}
            {# matching the operator page.                       #}
            <p class="govuk-body govuk-!-margin-bottom-1"
               data-testid="interim-sites-label"><strong>Interim sites ({{ site.interimSites.length }})</strong></p>
            {% for interimSite in site.interimSites %}
              {# The testids stay unsuffixed. mgmt-tests reads   #}
              {# these as collections already (flaggedBlockNames,#}
              {# newTagCount), so repeating them per interim     #}
              {# site is what those helpers expect; suffixing    #}
              {# would break every one of them for no gain.      #}
              <details class="govuk-details app-interim-site govuk-!-margin-bottom-1"
                       data-testid="interim-site">
                <summary class="govuk-details__summary">
                  {# The testid sits on the <strong>, not the   #}
                  {# wrapping <span>: the NEW marker is itself   #}
                  {# a <span>, so a same-tag nesting would make  #}
                  {# any "text of this element" reader stop at   #}
                  {# the marker's closing tag and see "NEW:"     #}
                  {# alone instead of the site name.             #}
                  <span class="govuk-details__summary-text"><strong data-testid="interim-site-name">{% if interimSite.isNew %}{{ newPrefix('interim-site-new-tag') }}{% endif %}{{ interimSite.siteName }}</strong></span>
                </summary>
                <div class="govuk-details__text">
                  {% if interimSite.addressLines.length %}
                    <p class="govuk-body govuk-!-margin-bottom-1"
                       data-testid="interim-site-address">{{ interimSite.addressLines | join(', ') }}</p>
                  {% endif %}
                  {{ siteDetails(interimSite.details, 'interim-site') }}
                </div>
              </details>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </details>
  {% else %}
    —
  {% endfor %}
{% endmacro %}

{# One business-plan category: bold label, PRN-income share, narrative.     #}
{# `testId` is a parameter because the AC02 business-plan row and the       #}
{# previous-year section render the same shape but are counted separately — #}
{# stamping `app-detail-pair` on both would make an AC02 pair count also    #}
{# pick up prior-year pairs.                                                #}
{% macro businessPlanPair(pair, testId='app-detail-pair') %}
  <p class="govuk-body govuk-!-margin-bottom-1" data-testid="{{ testId }}">
    <strong>{{ pair.label }}</strong>{% if pair.percent %} — {{ pair.percent }}{% endif %}{% if pair.detail %}<br>{{ pair.detail }}{% endif %}
  </p>
{% endmacro %}

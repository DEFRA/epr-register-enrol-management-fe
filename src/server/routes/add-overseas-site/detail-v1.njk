{# ------------------------------------------------------------------- #}
{# Add-ORS detail template (v1) — RA-739.                               #}
{#                                                                      #}
{# The "Application summary" tab, from the Figma "Application page -    #}
{# Summary" frame. RA-495: extends the Standard-lifecycle detail page,  #}
{# as re-accreditation's does, for the case tabs, the notices and error #}
{# banners, the assignment panel, the pending-contact banner, the       #}
{# Duly make / Make Determination / Confirm applicant contact CTAs and   #}
{# the closed case's Outcome panel. It replaces the application data   #}
{# with the add-ORS site summary (`applicationSummary`, built by the    #}
{# type's own summary builder).                                         #}
{#                                                                      #}
{# add-ORS has no generic actions (no Query, no Withdraw), so the       #}
{# generic actions list and its "No actions" line never render under    #}
{# the lifecycle CTAs.                                                  #}
{#                                                                      #}
{# `data-state-id` carries the raw state id for the journey tests.      #}
{# ------------------------------------------------------------------- #}
{% extends 'standard-lifecycle/detail.njk' %}

{% set lifecycleHidesGenericActions = true %}

{% from "work-items/summary-macros.njk" import documentItem, newPrefix, siteDetails %}

{% block content %}
  <div data-testid="add-overseas-site-detail"
       data-state-id="{{ workItem.stateId }}">
    {{ super() }}
  </div>
{% endblock %}

{% block applicationSummary %}
  {# The site, under re-accreditation's heading and borderless as its   #}
  {# application details. Every row renders; a missing value is the     #}
  {# dash. The row and value testids match re-accreditation's. RA-495: a #}
  {# value the operator supplied on this request, rather than one from  #}
  {# the site's registration, carries the "NEW: " prefix.               #}
  <h2 class="govuk-heading-m" data-testid="application-details-heading">Application details</h2>
  {# The Valid from date leads, set apart from the site's rows by a gap,  #}
  {# and only once the determination has recorded one.                    #}
  {% if applicationSummary.validFrom %}
    <dl class="govuk-summary-list app-summary-list--borderless govuk-!-margin-bottom-6"
        data-testid="application-valid-from">
      <div class="govuk-summary-list__row" data-testid="app-detail-row-valid-from">
        <dt class="govuk-summary-list__key">{{ applicationSummary.validFrom.label }}</dt>
        <dd class="govuk-summary-list__value" data-testid="app-detail-value-valid-from">
          <p class="govuk-body govuk-!-margin-bottom-0">{{ applicationSummary.validFrom.value }}</p>
        </dd>
      </div>
    </dl>
  {% endif %}
  <dl class="govuk-summary-list app-summary-list--borderless" data-testid="application-details">
    {% for row in applicationSummary.rows %}
      <div class="govuk-summary-list__row"
           data-testid="app-detail-row-{{ row.key }}">
        <dt class="govuk-summary-list__key">{{ row.label }}</dt>
        <dd class="govuk-summary-list__value"
            data-testid="app-detail-value-{{ row.key }}">
          {% if row.kind == 'files' %}
            {% if row.files.length %}
              <ul class="govuk-list govuk-!-margin-bottom-0">
                {% for file in row.files %}{{ documentItem(file, showDates=true, newTestId=('app-detail-supplied-' + row.key) if (row.supplied and loop.first) else '') }}{% endfor %}
              </ul>
            {% else %}
              <span data-testid="app-detail-documents-none">No documents uploaded.</span>
            {% endif %}
          {% else %}
            {% for line in row.values %}
              <p class="govuk-body govuk-!-margin-bottom-0">{% if row.supplied and loop.first %}{{ newPrefix('app-detail-supplied-' + row.key) }}{% endif %}{{ line }}</p>
            {% endfor %}
          {% endif %}
        </dd>
      </div>
    {% endfor %}
  </dl>

  {# Interim sites the operator has not withdrawn; no section without any. #}
  {% if applicationSummary.interimSites.length %}
    <div class="govuk-!-margin-top-8" data-testid="interim-sites">
      <h2 class="govuk-heading-m" data-testid="interim-sites-heading">Interim sites ({{ applicationSummary.interimSites.length }})</h2>
      {# Always open, with no left border (user, 2026-11-20): the name    #}
      {# is the heading, plus the short address only when two interim    #}
      {# sites share a name, then the site's rows as borderless.         #}
      {% for interimSite in applicationSummary.interimSites %}
        <div class="govuk-!-margin-bottom-4" data-testid="interim-site">
          <h3 class="govuk-heading-s govuk-!-margin-bottom-2">
            <span data-testid="interim-site-name">{{ interimSite.siteName }}</span>
            {% if interimSite.shortAddress %}
              <br>
              <span class="govuk-!-font-weight-regular" data-testid="interim-site-summary-address">{{ interimSite.shortAddress }}</span>
            {% endif %}
          </h3>
          {{ siteDetails(interimSite.details, 'interim-site') }}
        </div>
      {% endfor %}
    </div>
  {% endif %}
{% endblock %}

{# RA-495. With the generic actions hidden, the card would be empty in a  #}
{# state with no lifecycle step to offer, so it renders only when one is: #}
{# Duly make, Make Determination, Confirm applicant contact, or the       #}
{# closed case's Outcome panel.                                           #}
{% block actionsCard %}
  {% if workItem.isReadOnlyState or workItem.isPendingContact or workItem.canDulyMake or workItem.canLogDecision %}
    {{ super() }}
  {% endif %}
{% endblock %}

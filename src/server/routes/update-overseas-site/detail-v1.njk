{# ------------------------------------------------------------------- #}
{# ORS update detail template (v1) — RA-782.                            #}
{#                                                                      #}
{# Extends the Standard-lifecycle detail page, as add-ORS's does, for   #}
{# the case tabs, banners, assignment panel and lifecycle CTAs, and     #}
{# replaces the application data with the ORS update summary           #}
{# (`applicationSummary`, built by the type's own summary builder):     #}
{# the ORS's details, current version against requested change, its    #}
{# BES evidence and its interim sites, each marked with what the update #}
{# does to it.                                                          #}
{#                                                                      #}
{# `data-state-id` carries the raw state id for the journey tests.      #}
{# ------------------------------------------------------------------- #}
{% extends 'standard-lifecycle/detail.njk' %}

{% set lifecycleHidesGenericActions = true %}

{% from "govuk/components/tag/macro.njk" import govukTag %}
{% from "work-items/summary-macros.njk" import documentItem, siteDetails %}

{# One Detail | Current version | Requested change table. A changed row  #}
{# is tagged "Changed" under its label, as text, so it does not rely on  #}
{# colour.                                                               #}
{% macro compareTable(rows, caption, testIdPrefix) %}
  <table class="govuk-table" data-testid="{{ testIdPrefix }}-table">
    {% if caption %}
      <caption class="govuk-table__caption govuk-table__caption--s">{{ caption }}</caption>
    {% endif %}
    <thead class="govuk-table__head">
      <tr class="govuk-table__row">
        <th scope="col" class="govuk-table__header govuk-!-width-one-quarter">Detail</th>
        <th scope="col" class="govuk-table__header">Current version</th>
        <th scope="col" class="govuk-table__header">Requested change</th>
      </tr>
    </thead>
    <tbody class="govuk-table__body">
      {% for row in rows %}
        <tr class="govuk-table__row"
            data-testid="{{ testIdPrefix }}-row-{{ row.key }}"
            data-changed="{{ 'true' if row.changed else 'false' }}">
          <th scope="row" class="govuk-table__header">
            {{ row.label }}
            {% if row.changed %}
              <br>{{ govukTag({ text: "Changed", classes: "govuk-tag--blue", attributes: { "data-testid": testIdPrefix + "-changed-" + row.key } }) }}
            {% endif %}
          </th>
          <td class="govuk-table__cell" data-testid="{{ testIdPrefix }}-current-{{ row.key }}">
            {% for line in row.current %}<p class="govuk-body govuk-!-margin-bottom-0">{{ line }}</p>{% endfor %}
          </td>
          <td class="govuk-table__cell" data-testid="{{ testIdPrefix }}-requested-{{ row.key }}">
            {% for line in row.requested %}<p class="govuk-body govuk-!-margin-bottom-0">{{ line }}</p>{% endfor %}
          </td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% endmacro %}

{% block content %}
  <div data-testid="update-overseas-site-detail"
       data-state-id="{{ workItem.stateId }}">
    {{ super() }}
  </div>
{% endblock %}

{% block applicationSummary %}
  <h2 class="govuk-heading-m" data-testid="application-details-heading">Application details</h2>
  <p class="govuk-body" data-testid="update-ors-intro">{{ applicationSummary.intro }}</p>

  {% for group in applicationSummary.groups %}
    <div data-testid="update-ors-group-{{ group.key }}">
      {{ compareTable(group.rows, group.title, 'update-ors') }}
    </div>
  {% endfor %}

  {# The ORS's own BES evidence, then any the update adds, tagged "New". #}
  <div class="govuk-!-margin-bottom-6" data-testid="update-ors-bes-evidence">
    <h3 class="govuk-heading-s">Broadly equivalent standards (BES) evidence</h3>
    {% if applicationSummary.besEvidence.files.length %}
      <ul class="govuk-list">
        {% for file in applicationSummary.besEvidence.files %}{{ documentItem(file, showDates=true, newTag=file.isNew) }}{% endfor %}
      </ul>
    {% else %}
      <p class="govuk-body" data-testid="app-detail-documents-none">No documents uploaded.</p>
    {% endif %}
  </div>

  {# Every active interim site and every one the update adds. One       #}
  {# collapsible section each: open when there is something to review,  #}
  {# closed when the update leaves it unchanged.                         #}
  {% if applicationSummary.interimSites.length %}
    <div class="govuk-!-margin-top-8" data-testid="interim-sites">
      <h2 class="govuk-heading-m" data-testid="interim-sites-heading">Interim sites</h2>
      {% for interimSite in applicationSummary.interimSites %}
        <details class="govuk-details"
                 data-testid="update-ors-interim-site"
                 data-change="{{ interimSite.kind }}"
                 {% if interimSite.open %}open{% endif %}>
          <summary class="govuk-details__summary">
            <span class="govuk-details__summary-text" data-testid="update-ors-interim-site-title">Interim site {{ interimSite.number }}: {{ interimSite.siteName }}</span>
            {{ govukTag({ text: interimSite.tag, classes: interimSite.tagClass, attributes: { "data-testid": "update-ors-interim-site-tag" } }) }}
          </summary>
          <div class="govuk-details__text">
            {% if interimSite.note %}
              <p class="govuk-body" data-testid="update-ors-interim-site-note">{{ interimSite.note }}</p>
            {% endif %}
            {% if interimSite.rows %}
              {{ compareTable(interimSite.rows, null, 'update-ors-interim') }}
            {% else %}
              {{ siteDetails(interimSite.details, 'interim-site') }}
            {% endif %}
          </div>
        </details>
      {% endfor %}
    </div>
  {% endif %}
{% endblock %}

{# As add-ORS: the actions card renders only when there is a lifecycle  #}
{# step or an outcome to show.                                           #}
{% block actionsCard %}
  {% if workItem.isReadOnlyState or workItem.isPendingContact or workItem.canDulyMake or workItem.canLogDecision %}
    {{ super() }}
  {% endif %}
{% endblock %}

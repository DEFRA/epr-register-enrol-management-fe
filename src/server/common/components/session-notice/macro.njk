{#
  RA-462 concurrent-login notice.

  Renders only when `notice` is set (by the concurrent-login onPostAuth
  extension, surfaced on the nunjucks context as `concurrentLoginNotice`).

  Styled like a GOV.UK notification banner but with its OWN classes
  (app-session-notice__*), NOT `govuk-notification-banner` — the notice can
  be on screen at the same time as a real page-level notification banner, and
  `$('.govuk-notification-banner')` selectors (e2e + app code) must still
  resolve to that page banner, not this. src/client/javascripts/session-notice.js
  progressively enhances it into a dismissible floating toast; without JS it
  stays in flow and the "Hide" button posts a normal form.

  Params:
    notice { variant: 'alert' | 'info', at: string }  - required to render
    crumb  CSRF token for the no-JS dismiss form
#}
{% macro sessionNotice(notice, crumb) %}
  {% if notice %}
    {% set isAlert = notice.variant == 'alert' %}
    <div
      class="app-session-notice"
      data-module="app-session-notice"
      data-testid="session-notice"
      data-variant="{{ notice.variant }}"
      data-dismiss-url="/auth/session-notice/dismiss"
    >
      <div
        class="app-session-notice__banner app-session-notice__banner--{{ notice.variant }}"
        role="{{ 'alert' if isAlert else 'region' }}"
        aria-labelledby="session-notice-title"
      >
        <div class="app-session-notice__header">
          <h2 class="app-session-notice__title" id="session-notice-title">Important</h2>
        </div>
        <div class="app-session-notice__content">
          {% if isAlert %}
            <p class="app-session-notice__heading" data-testid="session-notice-heading">A new sign-in to your account was detected</p>
            <p class="govuk-body" data-testid="session-notice-body">Someone signed in to your account at {{ notice.at }}. If this was not you, sign out and contact your administrator.</p>
            <p class="govuk-body">
              <a class="govuk-link app-session-notice__link" href="/auth/logout" data-testid="session-notice-signout">Sign out</a>
            </p>
          {% else %}
            <p class="app-session-notice__heading" data-testid="session-notice-heading">You are signed in on another device</p>
            <p class="govuk-body" data-testid="session-notice-body">You were already signed in on another browser or device at {{ notice.at }}. Both sessions will stay signed in.</p>
          {% endif %}
          <form
            method="post"
            action="/auth/session-notice/dismiss"
            class="app-session-notice__dismiss"
          >
            <input type="hidden" name="crumb" value="{{ crumb }}">
            <button
              type="submit"
              class="govuk-link app-session-notice__dismiss-button"
              data-testid="session-notice-dismiss"
            >Hide</button>
          </form>
        </div>
      </div>
    </div>
  {% endif %}
{% endmacro %}

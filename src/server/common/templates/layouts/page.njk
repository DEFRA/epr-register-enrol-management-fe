{% extends "govuk/template.njk" %}

{# Import GOVUK components globally #}
{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}
{% from "govuk/components/cookie-banner/macro.njk" import govukCookieBanner %}
{% from "govuk/components/service-navigation/macro.njk" import govukServiceNavigation %}

{# Import custom components globally #}
{% from "heading/macro.njk" import appHeading %}
{% from "case-header/macro.njk" import appCaseHeader %}
{% from "case-tabs/macro.njk" import appCaseTabs %}
{% from "session-notice/macro.njk" import sessionNotice %}

{% set mainClasses = "app-main-wrapper" %}

{% block headIcons %}
  <link rel="icon" sizes="48x48" href="{{ getAssetPath("node_modules/govuk-frontend/dist/govuk/assets/images/favicon.ico") }}">
  <link rel="icon" sizes="any" href="{{ getAssetPath("node_modules/govuk-frontend/dist/govuk/assets/images/favicon.svg") }}" type="image/svg+xml" >
  <link rel="mask-icon" href="{{ getAssetPath("node_modules/govuk-frontend/dist/govuk/assets/images/govuk-icon-mask.svg") }}" color="{{ themeColor }}">
  <link rel="apple-touch-icon" href="{{ getAssetPath("node_modules/govuk-frontend/dist/govuk/assets/images/govuk-icon-180.png") }}">
  <link rel="manifest" href="{{ getAssetPath("node_modules/govuk-frontend/dist/govuk/assets/manifest.json") }}">
{% endblock %}

{% block head %}
  <link href="{{ getAssetPath('src/client/stylesheets/application.scss') }}" rel="stylesheet">
  {# The CSP refuses GTM's inline snippet, so a bundled script does its job. #}
  {% if analytics.gtmContainerId %}
    <meta name="analytics-gtm-container-id" content="{{ analytics.gtmContainerId }}">
    <script type="module" src="{{ getAssetPath('src/client/javascripts/analytics.js') }}"></script>
  {% endif %}
{% endblock %}

{# GOV.UK requires the cookie banner before the skip link. #}
{% block bodyStart %}
  {% if not hideCookieBanner %}
    {% if analytics.shouldAskConsent %}
      <form method="post" action="/cookies/consent" data-testid="cookie-banner-form">
        <input type="hidden" name="crumb" value="{{ crumb }}">
        <input type="hidden" name="returnUrl" value="{{ analytics.returnUrl }}">
        {{ govukCookieBanner({
          ariaLabel: "Cookies on " + serviceName,
          attributes: { 'data-testid': 'cookie-banner' },
          messages: [{
            headingText: "Cookies on " + serviceName,
            html: '<p class="govuk-body">We use some essential cookies to make this service work.</p><p class="govuk-body">We&#39;d also like to use analytics cookies so we can understand how you use the service and make improvements.</p>',
            actions: [
              {
                text: "Accept analytics cookies",
                type: "submit",
                name: "analytics",
                value: "accepted",
                attributes: { 'data-testid': 'cookie-banner-accept' }
              },
              {
                text: "Reject analytics cookies",
                type: "submit",
                name: "analytics",
                value: "rejected",
                attributes: { 'data-testid': 'cookie-banner-reject' }
              },
              {
                text: "View cookies",
                href: "/cookies"
              }
            ]
          }]
        }) }}
      </form>
    {% elif analytics.confirmation %}
      {{ govukCookieBanner({
        ariaLabel: "Cookies on " + serviceName,
        attributes: { 'data-testid': 'cookie-banner-confirmation' },
        messages: [{
          html: '<p class="govuk-body">You&#39;ve ' + analytics.confirmation + ' analytics cookies. You can <a class="govuk-link" href="/cookies">change your cookie settings</a> at any time.</p>',
          role: "alert",
          actions: [
            {
              text: "Hide cookie message",
              href: analytics.returnUrl,
              attributes: { 'data-testid': 'cookie-banner-hide' }
            }
          ]
        }]
      }) }}
    {% endif %}
  {% endif %}
{% endblock %}

{% block header %}
  <header class="govuk-header" role="banner">
    <div class="govuk-header__container govuk-width-container">
      <div class="govuk-header__logo">
        <img
          src="{{ getAssetPath('src/client/images/defra-logo-wide.svg') }}"
          alt="Department for Environment, Food and Rural Affairs"
          class="app-header__logo-img"
        >
      </div>
    </div>
  </header>

  {% if user %}
    {# RA-324 (AC01/AC03). Sign out is appended on every authenticated page, #}
    {# alongside the persistent "Work items" nav link. Stable e2e hook.       #}
    {% set serviceNavItems = navigation.concat([{ text: 'Sign out', href: '/auth/logout', attributes: { 'data-testid': 'nav-sign-out' } }]) %}
  {% else %}
    {% set serviceNavItems = navigation %}
  {% endif %}
  {{ govukServiceNavigation({
    serviceName: serviceName,
    serviceUrl: serviceUrl,
    navigation: serviceNavItems
  }) }}
{% endblock %}

{% block pageTitle %}
  {{ pageTitle }} | {{ serviceName }}
{% endblock %}

{% block container %}
  {# RA-295. The case header is full-bleed: it has to render OUTSIDE the       #}
  {# govuk-width-container that `super()` opens, so it gets its own block here #}
  {# rather than living in `beforeContent`. Pages that set `caseHeader` (the   #}
  {# individual work item pages) render it; everything else is unaffected.     #}
  {% block caseHeader %}
    {% if caseHeader %}
      {{ appCaseHeader(caseHeader) }}
    {% endif %}
  {% endblock %}
  <div class="app-main-background">
    {{ super() }}
  </div>
{% endblock %}

{% block beforeContent %}
  {{ sessionNotice(concurrentLoginNotice, crumb) }}
  {% if breadcrumbs.length > 1 %}
    {{ govukBreadcrumbs({
      items: breadcrumbs
    }) }}
  {% endif %}
{% endblock %}

{% block content %}{% endblock %}

{% block footer %}
  <footer class="govuk-template__footer">
    <div class="govuk-footer">
      <div class="govuk-width-container">
        <div class="govuk-footer__meta">
          <div class="govuk-footer__meta-item govuk-footer__meta-item--grow">
            <h2 class="govuk-visually-hidden">Support links</h2>
            <ul class="govuk-footer__inline-list">
              <li class="govuk-footer__inline-list-item">
                <a class="govuk-footer__link" href="/cookies" data-testid="footer-cookies">Cookies</a>
              </li>
            </ul>
            <p class="govuk-footer__body">A Department for Environment, Food &amp; Rural Affairs Digital, Data and Technology service</p>
          </div>
        </div>
      </div>
    </div>
  </footer>
{% endblock %}

{% block bodyEnd %}
  <script type="module" src="{{ getAssetPath('src/client/javascripts/application.js') }}"></script>
{% endblock %}
